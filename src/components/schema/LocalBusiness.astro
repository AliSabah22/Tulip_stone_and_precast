---
// JSON-LD LocalBusiness schema — included on every page via BaseLayout.
// Emits one node per location from src/data/locations.js. Location pages
// pass `only` so they emit just their own node; every other page
// (including the homepage) references both locations.
import { locations, localBusinessSchema } from '../../data/locations.js';

export interface Props {
  only?: string;
}

const { only } = Astro.props;
const nodes = locations
  .filter((l) => !only || l.id === only)
  .map((l) => localBusinessSchema(l));
---

<script type="application/ld+json" set:html={JSON.stringify(nodes.length === 1 ? nodes[0] : nodes)} />
