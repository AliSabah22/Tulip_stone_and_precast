---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTASection from '../components/CTASection.astro';

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you supply limestone veneer for masonry crews working in Toronto?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We fabricate full bed and thin bed Indiana Limestone veneer, corner units, and coursing accessories, palletized for direct delivery to Toronto job sites and matched to the coursing pattern your masonry crew is installing."
      }
    },
    {
      "@type": "Question",
      "name": "Can limestone masonry units be matched to a specific mortar joint width?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We fabricate to the joint width specified in your masonry drawings, including corner returns and coursing accessories, so units lay up consistently without field cutting to compensate for mismatched dimensions."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide limestone sills, banding, and trim to accompany a masonry veneer installation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Sills, banding, water tables, and wall caps are fabricated alongside veneer orders so masons receive a complete trim package for the elevation, not just field stone."
      }
    },
    {
      "@type": "Question",
      "name": "How is limestone masonry material delivered to a Toronto job site?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Veneer and masonry trim ship palletized from our Brampton shop directly to Toronto sites, sequenced with your mason's schedule. Our team handles unloading on standard deliveries."
      }
    }
  ]
});

const localBizSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Tulip Limestone · Precast",
  "description": "Indiana Limestone masonry veneer and trim fabrication supplying masonry contractors and crews in Toronto, Ontario.",
  "url": "https://www.tulipstone.ca/limestone-masonry-toronto",
  "telephone": "+1-647-534-7755",
  "email": "office@tulipprecast.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "98 Rutherford Rd Unit 2C",
    "addressLocality": "Brampton",
    "addressRegion": "ON",
    "postalCode": "L6W 3J5",
    "addressCountry": "CA"
  },
  "areaServed": {
    "@type": "City",
    "name": "Toronto"
  },
  "priceRange": "$$$"
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.tulipstone.ca" },
    { "@type": "ListItem", "position": 2, "name": "Limestone Masonry Toronto", "item": "https://www.tulipstone.ca/limestone-masonry-toronto" }
  ]
});

const combinedSchema = JSON.stringify([
  JSON.parse(faqSchema),
  JSON.parse(localBizSchema),
  JSON.parse(breadcrumbSchema),
]);
---

<BaseLayout
  title="Limestone Masonry Toronto | Veneer &amp; Trim Supply | Tulip"
  description="Indiana Limestone masonry veneer and trim for Toronto masonry contractors. Full bed and thin bed veneer, matched coursing, and direct-to-site delivery. Request a quote."
  pageClass="page-geo-service-toronto"
  solidNav={true}
  additionalSchema={combinedSchema}
>

  <Hero
    size="xs"
    imageSrc="/pictures/masonry%20detail.jpg"
    imageAlt="Indiana Limestone masonry veneer detail for Toronto masonry contractors — Tulip Limestone Precast"
    eyebrow="TORONTO, ONTARIO · MASONRY VENEER &amp; TRIM"
    headline="Limestone Masonry"
    headlineItalic="in Toronto."
    primaryCTA="REQUEST A VENEER QUOTE"
    primaryCTAHref="/contact?location=toronto&audience=masonry"
    secondaryCTA="TALK TO OUR SHOP"
    secondaryCTAHref="/contact"
  />

  <section class="geo-intro" aria-label="Limestone masonry veneer services in Toronto">
    <div class="geo-intro-container">
      <div class="geo-intro-text">
        <span class="label-section">Toronto, Ontario · Masonry Veneer Supply</span>
        <h2 class="geo-intro-headline">Limestone masonry veneer fabricated to how your crew lays it up.</h2>
        <span class="geo-intro-rule draw-line" aria-hidden="true"></span>
        <p class="geo-intro-body">Tulip Limestone · Precast fabricates Indiana Limestone veneer, coursing accessories, and trim for masonry contractors building in Toronto. Units are cut to the joint width and coursing pattern in your masonry drawings, so your crew lays up consistent courses without field-cutting to make pieces fit.</p>
        <p class="geo-intro-body">We supply full bed veneer for structural masonry applications and thin bed veneer for lightweight cladding, along with the sills, banding, and trim that complete the elevation package — all palletized and delivered directly to your Toronto site.</p>
      </div>
      <div class="geo-intro-facts">
        <div class="geo-fact">
          <span class="geo-fact-val">Matched</span>
          <span class="geo-fact-lbl">Coursing &amp; mortar joint width</span>
        </div>
        <div class="geo-fact">
          <span class="geo-fact-val">Full &amp; Thin</span>
          <span class="geo-fact-lbl">Bed veneer, both available</span>
        </div>
        <div class="geo-fact">
          <span class="geo-fact-val">Palletized</span>
          <span class="geo-fact-lbl">Delivery to the Toronto site</span>
        </div>
      </div>
    </div>
  </section>

  <section class="geo-products" aria-label="Masonry veneer and trim range">
    <div class="geo-products-container">
      <span class="label-section">Supplied for Toronto Masonry Projects</span>
      <h2 class="geo-products-title">The veneer and trim range.</h2>
      <p class="geo-products-intro">Everything a masonry crew needs for a limestone elevation, fabricated to match and delivered together.</p>
      <div class="geo-products-grid">
        <a href="/limestone/veneers" class="geo-product-tile">
          <span class="geo-product-name">Veneers</span>
          <span class="geo-product-desc">Full bed and thin bed veneer in six styles, matched coursing.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/sills" class="geo-product-tile">
          <span class="geo-product-name">Sills</span>
          <span class="geo-product-desc">Slip and lug sills coordinated with the veneer course height.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/banding" class="geo-product-tile">
          <span class="geo-product-name">Banding &amp; Water Tables</span>
          <span class="geo-product-desc">Continuous banding runs that align with veneer coursing.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/quoins" class="geo-product-tile">
          <span class="geo-product-name">Quoins</span>
          <span class="geo-product-desc">Corner units fabricated to the same joint width as the field.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/wall-caps" class="geo-product-tile">
          <span class="geo-product-name">Wall Caps</span>
          <span class="geo-product-desc">Double wash caps that shed water off masonry below.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/pavers" class="geo-product-tile">
          <span class="geo-product-name">Pavers</span>
          <span class="geo-product-desc">Matching limestone pavers for hardscape alongside the veneer.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="geo-why" aria-label="Why masonry contractors choose Tulip">
    <div class="geo-why-container">
      <span class="label-section">Why Toronto Masons Choose Tulip</span>
      <h2 class="geo-why-title">Veneer that lays up the way it was drawn.</h2>
      <div class="geo-why-grid">
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">01</span>
          <h3 class="geo-why-heading">Coursing confirmed before fabrication</h3>
          <p class="geo-why-body">We check joint width and course height against your masonry drawings before cutting, so veneer, corners, and trim line up on the wall without rework.</p>
        </div>
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">02</span>
          <h3 class="geo-why-heading">Corners and trim supplied together</h3>
          <p class="geo-why-body">Corner units, sills, banding, and caps ship as one coordinated order, so your crew isn't waiting on a second supplier for the pieces that tie the elevation together.</p>
        </div>
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">03</span>
          <h3 class="geo-why-heading">Delivery sequenced to your crew</h3>
          <p class="geo-why-body">Palletized veneer arrives in Toronto sequenced to your install schedule, so material is on site when the crew needs it and not stacking up before scaffold is ready.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="geo-faq" aria-label="Frequently asked questions">
    <div class="geo-faq-container">
      <span class="label-section">Common Questions</span>
      <h2 class="geo-faq-title">Toronto Masonry — Frequently Asked</h2>
      <div class="geo-faq-list">
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Do you supply limestone veneer for masonry crews working in Toronto?</summary>
          <div class="geo-faq-a"><p>Yes. We fabricate full bed and thin bed Indiana Limestone veneer, corner units, and coursing accessories, palletized for direct delivery to Toronto job sites and matched to the coursing pattern your masonry crew is installing.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Can limestone masonry units be matched to a specific mortar joint width?</summary>
          <div class="geo-faq-a"><p>Yes. We fabricate to the joint width specified in your masonry drawings, including corner returns and coursing accessories, so units lay up consistently without field cutting to compensate for mismatched dimensions.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Do you provide limestone sills, banding, and trim to accompany a masonry veneer installation?</summary>
          <div class="geo-faq-a"><p>Yes. Sills, banding, water tables, and wall caps are fabricated alongside veneer orders so masons receive a complete trim package for the elevation, not just field stone.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">How is limestone masonry material delivered to a Toronto job site?</summary>
          <div class="geo-faq-a"><p>Veneer and masonry trim ship palletized from our Brampton shop directly to Toronto sites, sequenced with your mason's schedule. Our team handles unloading on standard deliveries.</p></div>
        </details>
      </div>
    </div>
  </section>

  <CTASection
    headline="Building a masonry veneer wall in Toronto?"
    subheading="Send us your masonry drawings. We'll match coursing and joint width and quote a delivery schedule for your crew."
    buttonText="REQUEST A VENEER QUOTE"
    buttonHref="/contact?location=toronto&audience=masonry"
    background="sage"
  />

  <div class="geo-other-areas">
    <span class="geo-other-label">Also serving</span>
    <a href="/toronto">Toronto General</a> ·
    <a href="/brampton">Brampton</a> ·
    <a href="/mississauga">Mississauga</a> ·
    <a href="/oakville">Oakville</a>
  </div>

</BaseLayout>

<style>
  .label-section {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--warm-sand);
    display: block;
    margin-bottom: var(--space-sm);
  }

  .geo-intro {
    background: var(--sand-pale);
    padding: var(--space-3xl) 0;
    border-bottom: 1px solid var(--sand-light);
  }
  .geo-intro-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }
  .geo-intro-headline {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-tight);
    margin: var(--space-xs) 0 var(--space-sm);
  }
  .geo-intro-rule {
    display: block; height: 1px; width: 60px;
    background: var(--sand-light);
    margin-bottom: var(--space-lg);
    transform-origin: left center;
  }
  .geo-intro-body {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: 62ch;
    margin-bottom: var(--space-md);
  }
  .geo-intro-facts {
    display: flex; flex-direction: column;
    gap: var(--space-sm); padding-top: var(--space-md);
  }
  .geo-fact {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    border-left: 3px solid var(--warm-sand);
    padding: var(--space-lg);
    display: flex; flex-direction: column; gap: 4px;
  }
  .geo-fact-val {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 300;
    color: var(--stone-dark); line-height: 1;
  }
  .geo-fact-lbl {
    font-family: var(--font-sans); font-size: 9px;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase; color: var(--stone-light);
  }

  .geo-products {
    padding: var(--space-3xl) 0;
    background: var(--limestone-cream);
  }
  .geo-products-container {
    max-width: var(--max-width);
    margin: 0 auto; padding: 0 var(--content-padding);
  }
  .geo-products-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    margin: var(--space-xs) 0 var(--space-sm);
  }
  .geo-products-intro {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: 60ch;
    margin-bottom: var(--space-xl);
  }
  .geo-products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }
  .geo-product-tile {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    padding: var(--space-lg);
    display: flex; flex-direction: column;
    gap: var(--space-xs);
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .geo-product-tile:hover {
    border-color: var(--warm-sand);
    transform: translateY(-2px);
  }
  .geo-product-name {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
  }
  .geo-product-desc {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    flex: 1;
  }
  .geo-product-arrow {
    font-size: var(--text-body);
    color: var(--sand-light);
    margin-top: var(--space-xs);
    transition: color 200ms ease, transform 200ms ease;
  }
  .geo-product-tile:hover .geo-product-arrow {
    color: var(--warm-sand);
    transform: translateX(4px);
  }

  .geo-why {
    background: var(--quarry-stone);
    padding: var(--space-3xl) 0;
  }
  .geo-why-container {
    max-width: var(--max-width);
    margin: 0 auto; padding: 0 var(--content-padding);
  }
  .geo-why .label-section { color: rgba(200,168,130,0.7); }
  .geo-why-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--white-warm);
    margin: var(--space-xs) 0 var(--space-xl);
  }
  .geo-why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .geo-why-card {
    border: 1px solid rgba(200,168,130,0.14);
    background: rgba(255,255,255,0.03);
    padding: var(--space-xl);
  }
  .geo-why-num {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    font-weight: 300;
    color: rgba(200,168,130,0.2);
    display: block; line-height: 1;
    margin-bottom: var(--space-sm);
  }
  .geo-why-heading {
    font-family: var(--font-serif);
    font-size: var(--text-title);
    font-weight: 400;
    color: var(--white-warm);
    margin-bottom: var(--space-sm);
  }
  .geo-why-body {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-light);
    line-height: var(--lh-body);
  }

  .geo-faq {
    background: var(--sand-pale);
    padding: var(--space-3xl) 0;
  }
  .geo-faq-container {
    max-width: 760px; margin: 0 auto;
    padding: 0 var(--content-padding);
  }
  .geo-faq-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    margin: var(--space-xs) 0 var(--space-xl);
  }
  .geo-faq-list {
    display: flex; flex-direction: column;
    border-top: 1px solid var(--cream-dark);
  }
  .geo-faq-item { border-bottom: 1px solid var(--cream-dark); }
  .geo-faq-q {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
    padding: var(--space-lg) 0;
    cursor: pointer; list-style: none;
    display: flex; align-items: center;
    justify-content: space-between; gap: var(--space-lg);
    transition: color 200ms ease;
  }
  .geo-faq-q::-webkit-details-marker { display: none; }
  .geo-faq-q::after {
    content: '+'; font-family: var(--font-sans);
    font-size: 18px; font-weight: 300;
    color: var(--warm-sand); flex-shrink: 0;
    transition: transform 300ms ease; line-height: 1;
  }
  .geo-faq-item[open] .geo-faq-q::after { transform: rotate(45deg); }
  .geo-faq-q:hover { color: var(--warm-sand); }
  .geo-faq-a {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 300ms ease;
  }
  .geo-faq-item[open] .geo-faq-a {
    grid-template-rows: 1fr;
  }
  .geo-faq-a p {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: none;
    margin: 0;
    padding-bottom: var(--space-lg);
    overflow: hidden;
    min-height: 0;
  }

  .geo-other-areas {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-lg) var(--content-padding);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-light);
    text-align: center;
    border-top: 1px solid var(--cream-dark);
  }
  .geo-other-label {
    font-size: 9px;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    display: block;
    margin-bottom: var(--space-xs);
  }
  .geo-other-areas a {
    color: var(--stone-mid);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .geo-other-areas a:hover { color: var(--warm-sand); }

  @media (max-width: 1024px) {
    .geo-intro-container { grid-template-columns: 1fr; gap: var(--space-xl); }
    .geo-intro-facts { flex-direction: row; flex-wrap: wrap; }
    .geo-fact { flex: 1; min-width: 150px; }
    .geo-products-grid { grid-template-columns: repeat(2, 1fr); }
    .geo-why-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .geo-products-grid { grid-template-columns: 1fr; }
    .geo-intro-facts { flex-direction: column; }
  }
</style>
