---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTASection from '../components/CTASection.astro';

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you work directly with general contractors and builders in Brampton?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. As a limestone contractor supplying trade accounts across Brampton, we work directly with general contractors, builders, and subcontractors — not just homeowners. We quote from drawings, coordinate delivery around your schedule, and provide a single point of contact through the project."
      }
    },
    {
      "@type": "Question",
      "name": "Can you provide shop drawings for permit or structural review?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Every custom order goes through in-house shop drawing production before fabrication begins. We can turn these around for permit submission, architect sign-off, or structural engineer review, and revise to match field conditions."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer trade pricing for contractors ordering multiple units or lots?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Contractors working across multiple units, phases, or lots receive volume pricing and consistent lead times on repeat orders. Set up a trade account by contacting our Brampton shop directly."
      }
    },
    {
      "@type": "Question",
      "name": "How do you coordinate delivery with other trades on an active job site?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We deliver directly to Brampton job sites and coordinate timing with your site superintendent so limestone arrives when the site is ready for it — not before framing, masonry, or crane access is in place. Our team handles unloading on standard deliveries."
      }
    }
  ]
});

const localBizSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Tulip Limestone · Precast",
  "description": "Limestone contractor and fabrication shop serving builders, general contractors, and subcontractors in Brampton, Ontario. Trade accounts, shop drawings, and direct-to-site delivery.",
  "url": "https://www.tulipstone.ca/limestone-contractor-brampton",
  "telephone": "+1-647-534-7755",
  "email": "office@tulipprecast.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "98 Rutherford Rd Unit 2C",
    "addressLocality": "Brampton",
    "addressRegion": "ON",
    "postalCode": "L6W 3J5",
    "addressCountry": "CA"
  },
  "areaServed": {
    "@type": "City",
    "name": "Brampton"
  },
  "priceRange": "$$$"
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.tulipstone.ca" },
    { "@type": "ListItem", "position": 2, "name": "Limestone Contractor Brampton", "item": "https://www.tulipstone.ca/limestone-contractor-brampton" }
  ]
});

const combinedSchema = JSON.stringify([
  JSON.parse(faqSchema),
  JSON.parse(localBizSchema),
  JSON.parse(breadcrumbSchema),
]);
---

<BaseLayout
  title="Limestone Contractor Brampton | Trade Fabrication Shop | Tulip"
  description="Limestone contractor serving builders and general contractors in Brampton, Ontario. Trade pricing, in-house shop drawings, and direct-to-site delivery. Request a trade quote."
  pageClass="page-geo-service-brampton"
  solidNav={true}
  additionalSchema={combinedSchema}
>

  <Hero
    size="xs"
    imageSrc="/pictures/craftsman%20hands.jpg"
    imageAlt="Limestone contractor fabrication shop Brampton Ontario — Tulip Limestone Precast"
    eyebrow="BRAMPTON, ONTARIO · TRADE &amp; CONTRACTOR ACCOUNTS"
    headline="Limestone Contractor"
    headlineItalic="in Brampton."
    primaryCTA="REQUEST A TRADE QUOTE"
    primaryCTAHref="/contact?location=brampton&audience=contractor"
    secondaryCTA="SET UP A TRADE ACCOUNT"
    secondaryCTAHref="/contact"
  />

  <section class="geo-intro" aria-label="Limestone contractor services in Brampton">
    <div class="geo-intro-container">
      <div class="geo-intro-text">
        <span class="label-section">Brampton, Ontario · Builder &amp; GC Supply</span>
        <h2 class="geo-intro-headline">A limestone contractor built around how builders actually work.</h2>
        <span class="geo-intro-rule draw-line" aria-hidden="true"></span>
        <p class="geo-intro-body">Tulip Limestone · Precast fabricates and supplies Indiana Limestone for general contractors, builders, and subcontractors across Brampton — not just one-off homeowner orders. We quote from drawings, produce our own shop drawings in-house, and coordinate delivery around your site schedule, not ours.</p>
        <p class="geo-intro-body">Whether you're a GC managing a custom home build, a subcontractor supplying stone to a masonry crew, or a builder running multiple units on the same elevation package, you get one Brampton-based point of contact from quote to delivery.</p>
      </div>
      <div class="geo-intro-facts">
        <div class="geo-fact">
          <span class="geo-fact-val">Trade</span>
          <span class="geo-fact-lbl">Accounts &amp; volume pricing</span>
        </div>
        <div class="geo-fact">
          <span class="geo-fact-val">In-house</span>
          <span class="geo-fact-lbl">Shop drawings for permit review</span>
        </div>
        <div class="geo-fact">
          <span class="geo-fact-val">Direct</span>
          <span class="geo-fact-lbl">Site delivery, scheduled with you</span>
        </div>
      </div>
    </div>
  </section>

  <section class="geo-products" aria-label="What we supply to contractors">
    <div class="geo-products-container">
      <span class="label-section">Supplied to Brampton Job Sites</span>
      <h2 class="geo-products-title">Fabricated to your elevation package.</h2>
      <p class="geo-products-intro">We fabricate the full range of Indiana Limestone trim and architectural elements that show up on a typical builder's elevation drawings, plus precast and GFRC alternatives where weight or budget matters.</p>
      <div class="geo-products-grid">
        <a href="/limestone/sills" class="geo-product-tile">
          <span class="geo-product-name">Sills</span>
          <span class="geo-product-desc">Slip and lug sills, standard and custom, to match your window schedule.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/banding" class="geo-product-tile">
          <span class="geo-product-name">Banding &amp; Water Tables</span>
          <span class="geo-product-desc">Continuous banding runs fabricated to consistent profile across units.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/columns" class="geo-product-tile">
          <span class="geo-product-name">Columns &amp; Quoins</span>
          <span class="geo-product-desc">Classical orders and corner quoins for front elevation packages.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/veneers" class="geo-product-tile">
          <span class="geo-product-name">Veneers</span>
          <span class="geo-product-desc">Full bed and thin bed veneer, palletized for masonry crews.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/precast" class="geo-product-tile">
          <span class="geo-product-name">Precast Concrete</span>
          <span class="geo-product-desc">A lower-cost alternative for repetitive trim on multi-unit projects.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/gfrc" class="geo-product-tile">
          <span class="geo-product-name">GFRC Panels</span>
          <span class="geo-product-desc">Up to 75% lighter where structural load or crane access is limited.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="geo-why" aria-label="Why contractors choose Tulip">
    <div class="geo-why-container">
      <span class="label-section">Why Brampton Builders Choose Tulip</span>
      <h2 class="geo-why-title">One supplier, one schedule, no surprises.</h2>
      <div class="geo-why-grid">
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">01</span>
          <h3 class="geo-why-heading">Drawings reviewed before fabrication</h3>
          <p class="geo-why-body">We confirm dimensions, profiles, and quantities against your drawing set before cutting starts, so field-fit surprises get caught at the shop drawing stage, not on site.</p>
        </div>
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">02</span>
          <h3 class="geo-why-heading">Consistent profiles across units</h3>
          <p class="geo-why-body">Multi-unit and multi-phase projects get the same profile, colour, and finish run after run — production notes are kept on file for repeat orders.</p>
        </div>
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">03</span>
          <h3 class="geo-why-heading">Delivery that fits your sequence</h3>
          <p class="geo-why-body">We schedule drop-off around your framing, masonry, or crane windows — not the other way around — and our team handles unloading on standard site deliveries.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="geo-faq" aria-label="Frequently asked questions">
    <div class="geo-faq-container">
      <span class="label-section">Common Questions</span>
      <h2 class="geo-faq-title">Brampton Contractors — Frequently Asked</h2>
      <div class="geo-faq-list">
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Do you work directly with general contractors and builders in Brampton?</summary>
          <div class="geo-faq-a"><p>Yes. As a limestone contractor supplying trade accounts across Brampton, we work directly with general contractors, builders, and subcontractors — not just homeowners. We quote from drawings, coordinate delivery around your schedule, and provide a single point of contact through the project.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Can you provide shop drawings for permit or structural review?</summary>
          <div class="geo-faq-a"><p>Yes. Every custom order goes through in-house shop drawing production before fabrication begins. We can turn these around for permit submission, architect sign-off, or structural engineer review, and revise to match field conditions.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Do you offer trade pricing for contractors ordering multiple units or lots?</summary>
          <div class="geo-faq-a"><p>Yes. Contractors working across multiple units, phases, or lots receive volume pricing and consistent lead times on repeat orders. Set up a trade account by contacting our Brampton shop directly.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">How do you coordinate delivery with other trades on an active job site?</summary>
          <div class="geo-faq-a"><p>We deliver directly to Brampton job sites and coordinate timing with your site superintendent so limestone arrives when the site is ready for it — not before framing, masonry, or crane access is in place. Our team handles unloading on standard deliveries.</p></div>
        </details>
      </div>
    </div>
  </section>

  <CTASection
    headline="Running a job in Brampton?"
    subheading="Send us your elevation drawings or specs. We'll quote trade pricing and a delivery schedule that matches your build."
    buttonText="REQUEST A TRADE QUOTE"
    buttonHref="/contact?location=brampton&audience=contractor"
    background="sage"
  />

  <div class="geo-other-areas">
    <span class="geo-other-label">Also serving</span>
    <a href="/brampton">Brampton Homeowners</a> ·
    <a href="/toronto">Toronto</a> ·
    <a href="/mississauga">Mississauga</a> ·
    <a href="/oakville">Oakville</a>
  </div>

</BaseLayout>

<style>
  .label-section {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--warm-sand);
    display: block;
    margin-bottom: var(--space-sm);
  }

  .geo-intro {
    background: var(--sand-pale);
    padding: var(--space-3xl) 0;
    border-bottom: 1px solid var(--sand-light);
  }
  .geo-intro-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }
  .geo-intro-headline {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-tight);
    margin: var(--space-xs) 0 var(--space-sm);
  }
  .geo-intro-rule {
    display: block; height: 1px; width: 60px;
    background: var(--sand-light);
    margin-bottom: var(--space-lg);
    transform-origin: left center;
  }
  .geo-intro-body {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: 62ch;
    margin-bottom: var(--space-md);
  }
  .geo-intro-facts {
    display: flex; flex-direction: column;
    gap: var(--space-sm); padding-top: var(--space-md);
  }
  .geo-fact {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    border-left: 3px solid var(--warm-sand);
    padding: var(--space-lg);
    display: flex; flex-direction: column; gap: 4px;
  }
  .geo-fact-val {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 300;
    color: var(--stone-dark); line-height: 1;
  }
  .geo-fact-lbl {
    font-family: var(--font-sans); font-size: 9px;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase; color: var(--stone-light);
  }

  .geo-products {
    padding: var(--space-3xl) 0;
    background: var(--limestone-cream);
  }
  .geo-products-container {
    max-width: var(--max-width);
    margin: 0 auto; padding: 0 var(--content-padding);
  }
  .geo-products-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    margin: var(--space-xs) 0 var(--space-sm);
  }
  .geo-products-intro {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: 60ch;
    margin-bottom: var(--space-xl);
  }
  .geo-products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }
  .geo-product-tile {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    padding: var(--space-lg);
    display: flex; flex-direction: column;
    gap: var(--space-xs);
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .geo-product-tile:hover {
    border-color: var(--warm-sand);
    transform: translateY(-2px);
  }
  .geo-product-name {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
  }
  .geo-product-desc {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    flex: 1;
  }
  .geo-product-arrow {
    font-size: var(--text-body);
    color: var(--sand-light);
    margin-top: var(--space-xs);
    transition: color 200ms ease, transform 200ms ease;
  }
  .geo-product-tile:hover .geo-product-arrow {
    color: var(--warm-sand);
    transform: translateX(4px);
  }

  .geo-why {
    background: var(--quarry-stone);
    padding: var(--space-3xl) 0;
  }
  .geo-why-container {
    max-width: var(--max-width);
    margin: 0 auto; padding: 0 var(--content-padding);
  }
  .geo-why .label-section { color: rgba(200,168,130,0.7); }
  .geo-why-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--white-warm);
    margin: var(--space-xs) 0 var(--space-xl);
  }
  .geo-why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .geo-why-card {
    border: 1px solid rgba(200,168,130,0.14);
    background: rgba(255,255,255,0.03);
    padding: var(--space-xl);
  }
  .geo-why-num {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    font-weight: 300;
    color: rgba(200,168,130,0.2);
    display: block; line-height: 1;
    margin-bottom: var(--space-sm);
  }
  .geo-why-heading {
    font-family: var(--font-serif);
    font-size: var(--text-title);
    font-weight: 400;
    color: var(--white-warm);
    margin-bottom: var(--space-sm);
  }
  .geo-why-body {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-light);
    line-height: var(--lh-body);
  }

  .geo-faq {
    background: var(--sand-pale);
    padding: var(--space-3xl) 0;
  }
  .geo-faq-container {
    max-width: 760px; margin: 0 auto;
    padding: 0 var(--content-padding);
  }
  .geo-faq-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    margin: var(--space-xs) 0 var(--space-xl);
  }
  .geo-faq-list {
    display: flex; flex-direction: column;
    border-top: 1px solid var(--cream-dark);
  }
  .geo-faq-item { border-bottom: 1px solid var(--cream-dark); }
  .geo-faq-q {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
    padding: var(--space-lg) 0;
    cursor: pointer; list-style: none;
    display: flex; align-items: center;
    justify-content: space-between; gap: var(--space-lg);
    transition: color 200ms ease;
  }
  .geo-faq-q::-webkit-details-marker { display: none; }
  .geo-faq-q::after {
    content: '+'; font-family: var(--font-sans);
    font-size: 18px; font-weight: 300;
    color: var(--warm-sand); flex-shrink: 0;
    transition: transform 300ms ease; line-height: 1;
  }
  .geo-faq-item[open] .geo-faq-q::after { transform: rotate(45deg); }
  .geo-faq-q:hover { color: var(--warm-sand); }
  .geo-faq-a {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 300ms ease;
  }
  .geo-faq-item[open] .geo-faq-a {
    grid-template-rows: 1fr;
  }
  .geo-faq-a p {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: none;
    margin: 0;
    padding-bottom: var(--space-lg);
    overflow: hidden;
    min-height: 0;
  }

  .geo-other-areas {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-lg) var(--content-padding);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-light);
    text-align: center;
    border-top: 1px solid var(--cream-dark);
  }
  .geo-other-label {
    font-size: 9px;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    display: block;
    margin-bottom: var(--space-xs);
  }
  .geo-other-areas a {
    color: var(--stone-mid);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .geo-other-areas a:hover { color: var(--warm-sand); }

  @media (max-width: 1024px) {
    .geo-intro-container { grid-template-columns: 1fr; gap: var(--space-xl); }
    .geo-intro-facts { flex-direction: row; flex-wrap: wrap; }
    .geo-fact { flex: 1; min-width: 150px; }
    .geo-products-grid { grid-template-columns: repeat(2, 1fr); }
    .geo-why-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .geo-products-grid { grid-template-columns: 1fr; }
    .geo-intro-facts { flex-direction: column; }
  }
</style>
