---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import LocationCard from '../components/locations/LocationCard.astro';
import { company, locations, cityList } from '../data/locations.js';
---

<BaseLayout
  title={`Request a Quote | Tulip Limestone & Precast | ${cityList()}`}
  description={`Request a quote from Tulip Precast in ${cityList()}, ON. Custom Indiana Limestone and precast concrete for residential and commercial projects across the GTA.`}
  pageClass="page-contact"
  solidNav={true}
  loadFormValidation={true}
  noindex={true}
>

  <div class="contact-page">
    <div class="container">

      <!-- Page heading -->
      <header class="contact-heading reveal">
        <h1 class="contact-title">
          Let's Build Something<br />
          <em class="contact-title-italic">Lasting.</em>
        </h1>
        <div class="draw-line contact-rule" aria-hidden="true"></div>
        <p class="contact-intro">
          Send us your drawings, measurements, or inspiration. We'll respond within one business day.
        </p>
      </header>

      <!-- 2-column layout -->
      <div class="contact-grid">

        <!-- LEFT: Form -->
        <div class="contact-form-col reveal">
          <h2 class="col-heading">Request a Quote</h2>
          <QuoteForm />
        </div>

        <!-- RIGHT: Contact info -->
        <aside class="contact-info-col reveal reveal-delay-2" aria-label="Contact information">
          <div class="contact-info-sticky">

            <!-- Direct contact -->
            <div class="info-block">
              <h3 class="info-block-heading">Direct Contact</h3>
              <div class="info-links">
                <a href={`mailto:${company.email}`} class="info-link info-link--email">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect x="1" y="3" width="14" height="10" rx="1" stroke="currentColor" stroke-width="1"/>
                    <path d="M1 4l7 5 7-5" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
                  </svg>
                  {company.email}
                </a>
                {company.phones.map((p) => (
                  <a href={`tel:${p.e164}`} class="info-link">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M1 2.5A1.5 1.5 0 012.5 1h1.1c.4 0 .8.3.9.7l.8 3.1a1 1 0 01-.3 1L4 6.8a10 10 0 004.2 4.2l1-.9a1 1 0 011-.3l3.1.8c.4.1.7.5.7.9v1.1a1.5 1.5 0 01-1.5 1.5C6.3 14 1 8.7 1 2.5z" stroke="currentColor" stroke-width="1"/>
                  </svg>
                    {p.display}
                  </a>
                ))}
              </div>
            </div>

            <!-- What to include -->
            <div class="info-block info-block--card">
              <h3 class="info-block-heading">What to Include</h3>
              <p class="info-block-note">For the most accurate quote, please include:</p>
              <ul class="include-list" role="list">
                <li class="include-item">
                  <span class="include-mark" aria-hidden="true">·</span>
                  Project type and location
                </li>
                <li class="include-item">
                  <span class="include-mark" aria-hidden="true">·</span>
                  Product category of interest
                </li>
                <li class="include-item">
                  <span class="include-mark" aria-hidden="true">·</span>
                  Approximate quantities
                </li>
                <li class="include-item">
                  <span class="include-mark" aria-hidden="true">·</span>
                  Any drawings or specifications
                </li>
                <li class="include-item">
                  <span class="include-mark" aria-hidden="true">·</span>
                  Desired timeline
                </li>
              </ul>
            </div>

            <!-- Delivery & Unloading -->
            <div class="info-block info-block--card">
              <h3 class="info-block-heading">Delivery &amp; Unloading</h3>
              <ul class="include-list" role="list">
                <li class="include-item">
                  <span class="include-mark" aria-hidden="true">·</span>
                  We deliver directly to your site across the GTA — Brampton, Toronto, Mississauga, Oakville, Richmond Hill, and surrounding areas.
                </li>
                <li class="include-item">
                  <span class="include-mark" aria-hidden="true">·</span>
                  Our team handles unloading at delivery. You do not need to arrange separate equipment or crew for standard residential deliveries.
                </li>
                <li class="include-item">
                  <span class="include-mark" aria-hidden="true">·</span>
                  For large commercial orders, delivery method and unloading logistics are confirmed with your site contact during the shop drawing phase.
                </li>
                <li class="include-item">
                  <span class="include-mark" aria-hidden="true">·</span>
                  Lead times vary by project complexity and current fabrication schedule. Contact us for a current estimate before specifying deadlines.
                </li>
              </ul>
              <p class="info-block-note">Questions about delivery? Call us at {company.phones[0].display} or email {company.email}</p>
            </div>

          </div>
        </aside>

      </div>

      <!-- Locations -->
      <section id="locations" class="contact-locations" aria-labelledby="contact-locations-heading">
        <h2 class="col-heading" id="contact-locations-heading">Our Locations</h2>
        <div class="contact-locations-grid">
          {locations.map((loc) => (
            <LocationCard location={loc} />
          ))}
        </div>
      </section>

    </div>
  </div>

</BaseLayout>

<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }

  /* ── Page wrapper ──────────────────────────────────── */

  .contact-page {
    background: var(--limestone-cream);
    padding-bottom: var(--space-3xl);
  }

  /* ── Heading ───────────────────────────────────────── */

  .contact-heading {
    padding-top: 120px;
    padding-bottom: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    color: var(--stone-dark);
  }

  .contact-title-italic {
    font-style: italic;
    color: var(--stone-mid);
  }

  .contact-rule {
    width: 40px;
    height: 1px;
    background: var(--warm-sand);
  }

  .contact-intro {
    font-size: var(--text-body);
    line-height: var(--lh-body);
    color: var(--stone-mid);
    max-width: 52ch;
  }

  /* ── Contact grid ──────────────────────────────────── */

  .contact-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  /* ── Column headings ───────────────────────────────── */

  .col-heading {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--stone-light);
    margin-bottom: var(--space-lg);
  }

  /* ── Sticky info column ────────────────────────────── */

  .contact-info-sticky {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* ── Info blocks ───────────────────────────────────── */

  .info-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--cream-dark);
  }

  .info-block:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .info-block-heading {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--stone-light);
  }

  /* ── Links ─────────────────────────────────────────── */

  .info-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .info-link {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-mid);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .info-link:hover {
    color: var(--warm-sand);
  }

  .info-link svg {
    flex-shrink: 0;
    color: var(--stone-light);
  }

  /* ── Locations ─────────────────────────────────────── */

  .contact-locations {
    margin-top: var(--space-3xl);
    scroll-margin-top: 100px;
  }

  .contact-locations-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  /* ── What to include card ──────────────────────────── */

  .info-block--card {
    background: var(--sand-pale);
    border: none;
    padding: var(--space-lg);
    padding-bottom: var(--space-lg);
  }

  .info-block-note {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-mid);
    font-style: italic;
    max-width: none;
  }

  .include-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .include-item {
    display: flex;
    gap: var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
  }

  .include-mark {
    color: var(--warm-sand);
    font-weight: 400;
    flex-shrink: 0;
  }

  /* ── Responsive ────────────────────────────────────── */

  @media (max-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-info-sticky {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .contact-locations-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.tulipstone.ca" },
    { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://www.tulipstone.ca/contact" }
  ]
}
</script>
