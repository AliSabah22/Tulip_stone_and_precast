---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTASection from '../components/CTASection.astro';

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you ship limestone products to Vancouver and BC?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We ship GFRC panels, Indiana Limestone thin bed veneer, and custom carved pieces to Vancouver and throughout British Columbia. We are upfront that heavy dimensional limestone — solid columns, balustrades, and pavers — is generally better sourced locally in BC due to freight costs on weight."
      }
    },
    {
      "@type": "Question",
      "name": "Why is GFRC a better fit than precast for shipping to BC?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GFRC is up to 75% lighter than standard precast concrete while offering superior flexural and tensile strength. That weight difference is what makes shipping across the country economically viable, and it also reduces structural load requirements and simplifies installation on arrival."
      }
    },
    {
      "@type": "Question",
      "name": "How does thin bed veneer compare on shipping cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Thin bed Indiana Limestone veneer averages approximately 135 square feet per ton and 3,000 square feet per truckload. That coverage-to-weight ratio makes it the most economical natural stone product to ship long distances. It also requires no footing and installs directly over existing masonry."
      }
    },
    {
      "@type": "Question",
      "name": "Are there customs or duty costs shipping to BC?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Shipping from Ontario to British Columbia is a domestic Canadian shipment — no international border, no customs brokerage, and no import duty. Freight cost only."
      }
    }
  ]
});

const localBizSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Tulip Limestone · Precast",
  "description": "Lightweight GFRC architectural panels and Indiana Limestone thin veneer shipped to Vancouver and British Columbia from Ontario.",
  "url": "https://www.tulipstone.ca/vancouver",
  "telephone": "+1-647-534-7755",
  "email": "office@tulipprecast.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "98 Rutherford Rd Unit 2C",
    "addressLocality": "Brampton",
    "addressRegion": "ON",
    "postalCode": "L6W 3J5",
    "addressCountry": "CA"
  },
  "areaServed": {
    "@type": "City",
    "name": "Vancouver"
  },
  "priceRange": "$$$"
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.tulipstone.ca" },
    { "@type": "ListItem", "position": 2, "name": "Vancouver", "item": "https://www.tulipstone.ca/vancouver" }
  ]
});

const combinedSchema = JSON.stringify([
  JSON.parse(faqSchema),
  JSON.parse(localBizSchema),
  JSON.parse(breadcrumbSchema),
]);
---

<BaseLayout
  title="GFRC Panels &amp; Limestone Veneer Vancouver, BC | Tulip"
  description="Lightweight GFRC architectural panels and Indiana Limestone thin veneer shipped to Vancouver and British Columbia. Up to 75% lighter than precast. Custom fabrication from Ontario. Domestic shipping."
  pageClass="page-geo-vancouver"
  solidNav={true}
  additionalSchema={combinedSchema}
>

  <Hero
    size="xs"
    imageSrc="/pictures/stone%20texture.jpg"
    imageAlt="Lightweight GFRC architectural panels and Indiana Limestone thin veneer for Vancouver projects — Tulip Precast"
    eyebrow="VANCOUVER, BC · GFRC &amp; LIGHTWEIGHT VENEER"
    headline="Lightweight Stone"
    headlineItalic="for Vancouver."
    primaryCTA="REQUEST A QUOTE"
    primaryCTAHref="/contact?location=vancouver"
    secondaryCTA="LEARN ABOUT GFRC"
    secondaryCTAHref="/gfrc"
  />

  <section class="geo-intro" aria-label="Vancouver GFRC and veneer services">
    <div class="geo-intro-container">
      <div class="geo-intro-text">
        <span class="label-section">Vancouver, British Columbia · Shipped Nationally</span>
        <h2 class="geo-intro-headline">The products that ship well, done properly.</h2>
        <span class="geo-intro-rule draw-line" aria-hidden="true"></span>
        <p class="geo-intro-body">We are honest about distance. Solid dimensional limestone shipped from Ontario to British Columbia is not competitive on freight — you are better served locally. What we do ship to Vancouver economically are the lightweight products: GFRC architectural panels and Indiana Limestone thin bed veneer.</p>
        <p class="geo-intro-body">GFRC is up to 75% lighter than standard precast concrete while offering superior flexural strength — which makes it viable to ship at distance and easier to install once it arrives. Thin bed veneer averages 135 square feet per ton and roughly 3,000 square feet per truckload, making it one of the most economical natural stone products to ship long distance.</p>
      </div>
      <div class="geo-intro-facts">
        <div class="geo-fact">
          <span class="geo-fact-val">75%</span>
          <span class="geo-fact-lbl">Lighter than standard precast (GFRC)</span>
        </div>
        <div class="geo-fact">
          <span class="geo-fact-val">135 sq ft</span>
          <span class="geo-fact-lbl">Per ton — thin bed veneer</span>
        </div>
        <div class="geo-fact">
          <span class="geo-fact-val">Domestic</span>
          <span class="geo-fact-lbl">No border, no customs, no duty</span>
        </div>
      </div>
    </div>
  </section>

  <section class="geo-products" aria-label="Products available">
    <div class="geo-products-container">
      <span class="label-section">What We Ship to Vancouver</span>
      <h2 class="geo-products-title">Lightweight products only.</h2>
      <p class="geo-products-intro">Heavy dimensional stone is better sourced locally in BC. These four products ship economically at distance.</p>
      <div class="geo-products-grid">
        <a href="/gfrc" class="geo-product-tile">
          <span class="geo-product-name">GFRC Panels</span>
          <span class="geo-product-desc">Up to 75% lighter than standard precast concrete.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/veneers" class="geo-product-tile">
          <span class="geo-product-name">Thin Bed Veneers</span>
          <span class="geo-product-desc">135 square feet per ton — the most economical natural stone to ship.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/carving" class="geo-product-tile">
          <span class="geo-product-name">Custom Carving</span>
          <span class="geo-product-desc">Bespoke, high-value pieces where freight cost is marginal.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/heritage-restoration" class="geo-product-tile">
          <span class="geo-product-name">Heritage Restoration</span>
          <span class="geo-product-desc">Profile matching and replica carving for historic buildings.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="geo-why" aria-label="Why choose Tulip">
    <div class="geo-why-container">
      <span class="label-section">Why This Works for Vancouver</span>
      <h2 class="geo-why-title">Freight economics we are honest about.</h2>
      <div class="geo-why-grid">
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">01</span>
          <h3 class="geo-why-heading">GFRC ships economically</h3>
          <p class="geo-why-body">Because GFRC is manufactured rather than quarried and weighs a fraction of solid stone, freight to British Columbia is genuinely viable — unlike heavy dimensional limestone.</p>
        </div>
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">02</span>
          <h3 class="geo-why-heading">Thin veneer freight economics</h3>
          <p class="geo-why-body">At roughly 135 square feet per ton and 3,000 square feet per truckload, thin bed veneer is the most economical natural stone to ship at distance. No footing required on installation either.</p>
        </div>
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">03</span>
          <h3 class="geo-why-heading">Custom work justifies the freight</h3>
          <p class="geo-why-body">Bespoke carving and heritage replica pieces are high-value and low-volume — the shipping cost is marginal relative to the piece.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="geo-faq" aria-label="Frequently asked questions">
    <div class="geo-faq-container">
      <span class="label-section">Common Questions</span>
      <h2 class="geo-faq-title">Vancouver — Frequently Asked</h2>
      <div class="geo-faq-list">
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Do you ship limestone products to Vancouver and BC?</summary>
          <div class="geo-faq-a"><p>We ship GFRC panels, Indiana Limestone thin bed veneer, and custom carved pieces to Vancouver and throughout British Columbia. We are upfront that heavy dimensional limestone — solid columns, balustrades, and pavers — is generally better sourced locally in BC due to freight costs on weight.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Why is GFRC a better fit than precast for shipping to BC?</summary>
          <div class="geo-faq-a"><p>GFRC is up to 75% lighter than standard precast concrete while offering superior flexural and tensile strength. That weight difference is what makes shipping across the country economically viable, and it also reduces structural load requirements and simplifies installation on arrival.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">How does thin bed veneer compare on shipping cost?</summary>
          <div class="geo-faq-a"><p>Thin bed Indiana Limestone veneer averages approximately 135 square feet per ton and 3,000 square feet per truckload. That coverage-to-weight ratio makes it the most economical natural stone product to ship long distances. It also requires no footing and installs directly over existing masonry.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Are there customs or duty costs shipping to BC?</summary>
          <div class="geo-faq-a"><p>No. Shipping from Ontario to British Columbia is a domestic Canadian shipment — no international border, no customs brokerage, and no import duty. Freight cost only.</p></div>
        </details>
      </div>
    </div>
  </section>

  <CTASection
    headline="Specifying GFRC or veneer in Vancouver?"
    subheading="Send us your drawings and panel dimensions. We will quote fabrication and freight together."
    buttonText="REQUEST A QUOTE"
    buttonHref="/contact?location=vancouver"
    background="sage"
  />

  <div class="geo-other-areas">
    <span class="geo-other-label">Also serving</span>
    <a href="/brampton">Brampton</a> ·
    <a href="/toronto">Toronto</a> ·
    <a href="/mississauga">Mississauga</a> ·
    <a href="/oakville">Oakville</a> ·
    <a href="/montreal">Montreal</a>
  </div>

</BaseLayout>

<style>
  .geo-intro {
    background: var(--sand-pale);
    padding: var(--space-3xl) 0;
    border-bottom: 1px solid var(--sand-light);
  }
  .geo-intro-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }
  .geo-intro-headline {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-tight);
    margin: var(--space-xs) 0 var(--space-sm);
  }
  .geo-intro-rule {
    display: block; height: 1px; width: 60px;
    background: var(--sand-light);
    margin-bottom: var(--space-lg);
    transform-origin: left center;
  }
  .geo-intro-body {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: 62ch;
    margin-bottom: var(--space-md);
  }
  .geo-intro-facts {
    display: flex; flex-direction: column;
    gap: var(--space-sm); padding-top: var(--space-md);
  }
  .geo-fact {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    border-left: 3px solid var(--warm-sand);
    padding: var(--space-lg);
    display: flex; flex-direction: column; gap: 4px;
  }
  .geo-fact-val {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 300;
    color: var(--stone-dark); line-height: 1;
  }
  .geo-fact-lbl {
    font-family: var(--font-sans); font-size: 9px;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase; color: var(--stone-light);
  }

  .geo-products {
    padding: var(--space-3xl) 0;
    background: var(--limestone-cream);
  }
  .geo-products-container {
    max-width: var(--max-width);
    margin: 0 auto; padding: 0 var(--content-padding);
  }
  .geo-products-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    margin: var(--space-xs) 0 var(--space-sm);
  }
  .geo-products-intro {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: 60ch;
    margin-bottom: var(--space-xl);
  }
  .geo-products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }
  .geo-product-tile {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    padding: var(--space-lg);
    display: flex; flex-direction: column;
    gap: var(--space-xs);
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .geo-product-tile:hover {
    border-color: var(--warm-sand);
    transform: translateY(-2px);
  }
  .geo-product-name {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
  }
  .geo-product-desc {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    flex: 1;
  }
  .geo-product-arrow {
    font-size: var(--text-body);
    color: var(--sand-light);
    margin-top: var(--space-xs);
    transition: color 200ms ease, transform 200ms ease;
  }
  .geo-product-tile:hover .geo-product-arrow {
    color: var(--warm-sand);
    transform: translateX(4px);
  }

  .geo-why {
    background: var(--quarry-stone);
    padding: var(--space-3xl) 0;
  }
  .geo-why-container {
    max-width: var(--max-width);
    margin: 0 auto; padding: 0 var(--content-padding);
  }
  .geo-why .label-section { color: rgba(200,168,130,0.7); }
  .geo-why-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--white-warm);
    margin: var(--space-xs) 0 var(--space-xl);
  }
  .geo-why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .geo-why-card {
    border: 1px solid rgba(200,168,130,0.14);
    background: rgba(255,255,255,0.03);
    padding: var(--space-xl);
  }
  .geo-why-num {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    font-weight: 300;
    color: rgba(200,168,130,0.2);
    display: block; line-height: 1;
    margin-bottom: var(--space-sm);
  }
  .geo-why-heading {
    font-family: var(--font-serif);
    font-size: var(--text-title);
    font-weight: 400;
    color: var(--white-warm);
    margin-bottom: var(--space-sm);
  }
  .geo-why-body {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-light);
    line-height: var(--lh-body);
  }

  .geo-faq {
    background: var(--sand-pale);
    padding: var(--space-3xl) 0;
  }
  .geo-faq-container {
    max-width: 760px; margin: 0 auto;
    padding: 0 var(--content-padding);
  }
  .geo-faq-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    margin: var(--space-xs) 0 var(--space-xl);
  }
  .geo-faq-list {
    display: flex; flex-direction: column;
    border-top: 1px solid var(--cream-dark);
  }
  .geo-faq-item { border-bottom: 1px solid var(--cream-dark); }
  .geo-faq-q {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
    padding: var(--space-lg) 0;
    cursor: pointer; list-style: none;
    display: flex; align-items: center;
    justify-content: space-between; gap: var(--space-lg);
    transition: color 200ms ease;
  }
  .geo-faq-q::-webkit-details-marker { display: none; }
  .geo-faq-q::after {
    content: '+'; font-family: var(--font-sans);
    font-size: 18px; font-weight: 300;
    color: var(--warm-sand); flex-shrink: 0;
    transition: transform 300ms ease; line-height: 1;
  }
  .geo-faq-item[open] .geo-faq-q::after { transform: rotate(45deg); }
  .geo-faq-q:hover { color: var(--warm-sand); }
  .geo-faq-a {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 300ms ease;
  }
  .geo-faq-item[open] .geo-faq-a {
    grid-template-rows: 1fr;
  }
  .geo-faq-a p {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: none;
    margin: 0;
    padding-bottom: var(--space-lg);
    overflow: hidden;
    min-height: 0;
  }

  .geo-other-areas {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-lg) var(--content-padding);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-light);
    text-align: center;
    border-top: 1px solid var(--cream-dark);
  }
  .geo-other-label {
    font-size: 9px;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    display: block;
    margin-bottom: var(--space-xs);
  }
  .geo-other-areas a {
    color: var(--stone-mid);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .geo-other-areas a:hover { color: var(--warm-sand); }

  @media (max-width: 1024px) {
    .geo-intro-container { grid-template-columns: 1fr; gap: var(--space-xl); }
    .geo-intro-facts { flex-direction: row; flex-wrap: wrap; }
    .geo-fact { flex: 1; min-width: 150px; }
    .geo-products-grid { grid-template-columns: repeat(2, 1fr); }
    .geo-why-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .geo-products-grid { grid-template-columns: 1fr; }
    .geo-intro-facts { flex-direction: column; }
  }
</style>
