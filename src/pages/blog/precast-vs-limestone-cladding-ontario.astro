    font-weight: 400;
    color: var(--stone-dark);
    padding: var(--space-lg) 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    transition: color 200ms ease;
  }
  .article-faq-q::-webkit-details-marker { display: none; }
  .article-faq-q::after {
    content: '+';
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 300;
    color: var(--warm-sand);
    flex-shrink: 0;
    transition: transform 300ms ease;
    line-height: 1;
  }
  .article-faq-item[open] .article-faq-q::after { transform: rotate(45deg); }
  .article-faq-q:hover { color: var(--warm-sand); }
  .article-faq-a p {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: none;
    margin: 0;
    padding-bottom: var(--space-lg);
  }

  /* ── Related ────────────────────────────────────────────── */
  .article-related {
    background: var(--limestone-cream);
    padding: var(--space-2xl) 0;
  }
  .article-related-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }
  .article-related-grid {
