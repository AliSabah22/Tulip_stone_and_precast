    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-mid);
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--space-lg);
    transition: color 200ms ease;
  }
  .article-back:hover { color: var(--warm-sand); }
  .article-category {
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--sage-green);
    display: block;
    margin-bottom: var(--space-xs);
  }
  .article-title {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
    font-weight: 300;
    color: var(--stone-dark);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-tight);
    margin: 0 0 var(--space-md);
  }
  .article-meta {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-light);
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-xs);
    margin: 0;
  }
  .article-meta-dot { color: var(--warm-sand); }

  /* ── Hero ───────────────────────────────────────────────── */
  .article-hero {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 var(--content-padding);
    transform: translateY(calc(var(--space-lg) * -1));
  }
  .article-hero-img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border: 1px solid var(--cream-dark);
  }

  /* ── Body ───────────────────────────────────────────────── */
  .article-body {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-lg) var(--content-padding) var(--space-2xl);
  }
  .article-body p,
  .article-body li {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: none;
  }
  .article-body p { margin: 0 0 var(--space-md); }
