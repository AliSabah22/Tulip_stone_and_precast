    font-family: var(--font-serif);
    font-size: var(--text-title);
    font-weight: 400;
    color: var(--stone-dark);
    line-height: var(--lh-heading);
    margin: var(--space-xl) 0 var(--space-sm);
  }
  .article-body ul {
    margin: 0 0 var(--space-md);
    padding-left: 1.25em;
  }
  .article-body li { margin-bottom: var(--space-xs); }
  .article-body strong { color: var(--stone-dark); font-weight: 400; }
  .article-body a {
    color: var(--stone-dark);
    text-decoration: underline;
    text-decoration-color: var(--warm-sand);
    text-underline-offset: 3px;
    transition: color 200ms ease;
  }
  .article-body a:hover { color: var(--warm-sand); }

  /* Short-answer callout */
  .article-answer {
    background: var(--sand-pale);
    border-left: 3px solid var(--warm-sand);
    padding: var(--space-lg);
    margin: 0 0 var(--space-xl);
  }
  .article-answer-label {
    font-family: var(--font-sans);
    font-size: 9px;
