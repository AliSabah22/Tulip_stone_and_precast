---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTASection from '../components/CTASection.astro';

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you supply limestone to Montreal and Quebec?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Tulip ships Indiana Limestone products from our Ontario fabrication facility to Montreal and throughout Quebec. As a domestic Canadian shipment there is no international border, customs brokerage, or duty involved."
      }
    },
    {
      "@type": "Question",
      "name": "Can you match limestone on a Montreal heritage building?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Heritage profile matching is one of our core capabilities. We work from photographs, physical measurements, and where available original architectural drawings to replicate the colour, texture, and exact profile of existing stonework. Please provide photographs and measurements when enquiring."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer custom stone carving for Montreal restoration projects?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Our carvers produce custom architectural ornament, capitals, medallions, corbels, and replica pieces for heritage restoration. Indiana Limestone is the preferred carving stone because it holds fine detail and does not splinter under carving tools."
      }
    },
    {
      "@type": "Question",
      "name": "What information do you need to quote a Montreal project?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Drawings and specifications, dimensions and quantities, and for replica or restoration work, photographs and measurements of the existing pieces. Send everything to office@tulipprecast.com or call 647-534-7755."
      }
    }
  ]
});

const localBizSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Tulip Limestone · Precast",
  "description": "Indiana Limestone fabrication and heritage stone restoration for Montreal, shipped from Ontario.",
  "url": "https://www.tulipstone.ca/montreal",
  "telephone": "+1-647-534-7755",
  "email": "office@tulipprecast.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "98 Rutherford Rd Unit 2C",
    "addressLocality": "Brampton",
    "addressRegion": "ON",
    "postalCode": "L6W 3J5",
    "addressCountry": "CA"
  },
  "areaServed": {
    "@type": "City",
    "name": "Montreal"
  },
  "priceRange": "$$$"
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.tulipstone.ca" },
    { "@type": "ListItem", "position": 2, "name": "Montreal", "item": "https://www.tulipstone.ca/montreal" }
  ]
});

const combinedSchema = JSON.stringify([
  JSON.parse(faqSchema),
  JSON.parse(localBizSchema),
  JSON.parse(breadcrumbSchema),
]);
---

<BaseLayout
  title="Indiana Limestone Montreal | Heritage Stone Restoration | Tulip"
  description="Indiana Limestone fabrication and heritage stone restoration for Montreal. Custom carving, profile matching, veneers, and GFRC panels. Shipped from Ontario. Serving Quebec architects and contractors."
  pageClass="page-geo-montreal"
  solidNav={true}
  additionalSchema={combinedSchema}
>

  <Hero
    size="xs"
    imageSrc="/pictures/masonry%20detail.jpg"
    imageAlt="Heritage limestone carving and profile matching for Montreal restoration projects — Tulip Limestone Precast"
    eyebrow="MONTRÉAL, QUÉBEC · HERITAGE &amp; NEW CONSTRUCTION"
    headline="Limestone for"
    headlineItalic="Montreal."
    primaryCTA="REQUEST A QUOTE"
    primaryCTAHref="/contact?location=montreal"
    secondaryCTA="CUSTOM CARVING"
    secondaryCTAHref="/limestone/carving"
  />

  <section class="geo-intro" aria-label="Montreal limestone services">
    <div class="geo-intro-container">
      <div class="geo-intro-text">
        <span class="label-section">Montréal, Québec · Heritage Restoration Specialists</span>
        <h2 class="geo-intro-headline">Heritage stone matching and custom carving for Montreal.</h2>
        <span class="geo-intro-rule draw-line" aria-hidden="true"></span>
        <p class="geo-intro-body">Montreal has one of the richest heritage stone architectures in North America — Old Montreal, the Plateau, Golden Square Mile. Restoring those buildings requires a fabricator who can match existing stone profiles precisely, carve replacement ornament by hand, and work from historical photographs and measurements rather than clean modern drawings.</p>
        <p class="geo-intro-body">That is exactly what we do. Tulip fabricates custom Indiana Limestone carvings, profile-matched replacement pieces, and architectural elements for Montreal heritage restoration and new construction. We ship from our Ontario facility with no international border and no customs complexity.</p>
      </div>
      <div class="geo-intro-facts">
        <div class="geo-fact">
          <span class="geo-fact-val">Heritage</span>
          <span class="geo-fact-lbl">Profile matching and replica carving</span>
        </div>
        <div class="geo-fact">
          <span class="geo-fact-val">No border</span>
          <span class="geo-fact-lbl">Domestic shipping within Canada</span>
        </div>
        <div class="geo-fact">
          <span class="geo-fact-val">Custom</span>
          <span class="geo-fact-lbl">Every piece from drawings or photographs</span>
        </div>
      </div>
    </div>
  </section>

  <section class="geo-products" aria-label="Products available">
    <div class="geo-products-container">
      <span class="label-section">Available in Montreal</span>
      <h2 class="geo-products-title">Heritage restoration, done precisely.</h2>
      <p class="geo-products-intro">Custom carving and profile matching, shipped domestically from Ontario.</p>
      <div class="geo-products-grid">
        <a href="/limestone/carving" class="geo-product-tile">
          <span class="geo-product-name">Custom Carving</span>
          <span class="geo-product-desc">Hand-carved ornament and architectural detail.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/heritage-restoration" class="geo-product-tile">
          <span class="geo-product-name">Heritage Restoration</span>
          <span class="geo-product-desc">Profile matching and replica carving for historic buildings.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/veneers" class="geo-product-tile">
          <span class="geo-product-name">Veneers</span>
          <span class="geo-product-desc">Full bed and thin bed veneer in six styles.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/sills" class="geo-product-tile">
          <span class="geo-product-name">Sills</span>
          <span class="geo-product-desc">Slip and lug sills in standard and custom profiles.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/banding" class="geo-product-tile">
          <span class="geo-product-name">Banding</span>
          <span class="geo-product-desc">Horizontal string courses in seven profiles.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/gfrc" class="geo-product-tile">
          <span class="geo-product-name">GFRC Panels</span>
          <span class="geo-product-desc">Lightweight architectural panels, up to 75% lighter than precast.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="geo-why" aria-label="Why choose Tulip">
    <div class="geo-why-container">
      <span class="label-section">Why Montreal Restorers Choose Tulip</span>
      <h2 class="geo-why-title">Precision matching, hand carving, no border.</h2>
      <div class="geo-why-grid">
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">01</span>
          <h3 class="geo-why-heading">Heritage profile matching</h3>
          <p class="geo-why-body">We replicate existing limestone profiles from photographs and measurements. Colour, texture, and dimension matched so replacement pieces integrate invisibly with original stonework.</p>
        </div>
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">02</span>
          <h3 class="geo-why-heading">Hand carving capability</h3>
          <p class="geo-why-body">Ornamental detail, capitals, medallions, corbels, and figurative work. Indiana Limestone holds fine carved detail for centuries — which is why it was specified on heritage buildings originally.</p>
        </div>
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">03</span>
          <h3 class="geo-why-heading">Domestic shipping</h3>
          <p class="geo-why-body">Shipping from Ontario to Quebec means no international border, no customs brokerage, and no duty. Straightforward domestic freight.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="geo-faq" aria-label="Frequently asked questions">
    <div class="geo-faq-container">
      <span class="label-section">Common Questions</span>
      <h2 class="geo-faq-title">Montreal — Frequently Asked</h2>
      <div class="geo-faq-list">
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Do you supply limestone to Montreal and Quebec?</summary>
          <div class="geo-faq-a"><p>Yes. Tulip ships Indiana Limestone products from our Ontario fabrication facility to Montreal and throughout Quebec. As a domestic Canadian shipment there is no international border, customs brokerage, or duty involved.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Can you match limestone on a Montreal heritage building?</summary>
          <div class="geo-faq-a"><p>Yes. Heritage profile matching is one of our core capabilities. We work from photographs, physical measurements, and where available original architectural drawings to replicate the colour, texture, and exact profile of existing stonework. Please provide photographs and measurements when enquiring.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Do you offer custom stone carving for Montreal restoration projects?</summary>
          <div class="geo-faq-a"><p>Yes. Our carvers produce custom architectural ornament, capitals, medallions, corbels, and replica pieces for heritage restoration. Indiana Limestone is the preferred carving stone because it holds fine detail and does not splinter under carving tools.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">What information do you need to quote a Montreal project?</summary>
          <div class="geo-faq-a"><p>Drawings and specifications, dimensions and quantities, and for replica or restoration work, photographs and measurements of the existing pieces. Send everything to office@tulipprecast.com or call 647-534-7755.</p></div>
        </details>
      </div>
    </div>
  </section>

  <CTASection
    headline="Restoring or building in Montreal?"
    subheading="Send us photographs and measurements of the existing stone. We will quote the replacement or replica work."
    buttonText="REQUEST A QUOTE"
    buttonHref="/contact?location=montreal"
    background="sage"
  />

  <div class="geo-other-areas">
    <span class="geo-other-label">Also serving</span>
    <a href="/brampton">Brampton</a> ·
    <a href="/toronto">Toronto</a> ·
    <a href="/mississauga">Mississauga</a> ·
    <a href="/oakville">Oakville</a> ·
    <a href="/vancouver">Vancouver</a>
  </div>

</BaseLayout>

<style>
  .geo-intro {
    background: var(--sand-pale);
    padding: var(--space-3xl) 0;
    border-bottom: 1px solid var(--sand-light);
  }
  .geo-intro-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }
  .geo-intro-headline {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-tight);
    margin: var(--space-xs) 0 var(--space-sm);
  }
  .geo-intro-rule {
    display: block; height: 1px; width: 60px;
    background: var(--sand-light);
    margin-bottom: var(--space-lg);
    transform-origin: left center;
  }
  .geo-intro-body {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: 62ch;
    margin-bottom: var(--space-md);
  }
  .geo-intro-facts {
    display: flex; flex-direction: column;
    gap: var(--space-sm); padding-top: var(--space-md);
  }
  .geo-fact {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    border-left: 3px solid var(--warm-sand);
    padding: var(--space-lg);
    display: flex; flex-direction: column; gap: 4px;
  }
  .geo-fact-val {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 300;
    color: var(--stone-dark); line-height: 1;
  }
  .geo-fact-lbl {
    font-family: var(--font-sans); font-size: 9px;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase; color: var(--stone-light);
  }

  .geo-products {
    padding: var(--space-3xl) 0;
    background: var(--limestone-cream);
  }
  .geo-products-container {
    max-width: var(--max-width);
    margin: 0 auto; padding: 0 var(--content-padding);
  }
  .geo-products-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    margin: var(--space-xs) 0 var(--space-sm);
  }
  .geo-products-intro {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: 60ch;
    margin-bottom: var(--space-xl);
  }
  .geo-products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }
  .geo-product-tile {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    padding: var(--space-lg);
    display: flex; flex-direction: column;
    gap: var(--space-xs);
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .geo-product-tile:hover {
    border-color: var(--warm-sand);
    transform: translateY(-2px);
  }
  .geo-product-name {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
  }
  .geo-product-desc {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    flex: 1;
  }
  .geo-product-arrow {
    font-size: var(--text-body);
    color: var(--sand-light);
    margin-top: var(--space-xs);
    transition: color 200ms ease, transform 200ms ease;
  }
  .geo-product-tile:hover .geo-product-arrow {
    color: var(--warm-sand);
    transform: translateX(4px);
  }

  .geo-why {
    background: var(--quarry-stone);
    padding: var(--space-3xl) 0;
  }
  .geo-why-container {
    max-width: var(--max-width);
    margin: 0 auto; padding: 0 var(--content-padding);
  }
  .geo-why .label-section { color: rgba(200,168,130,0.7); }
  .geo-why-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--white-warm);
    margin: var(--space-xs) 0 var(--space-xl);
  }
  .geo-why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .geo-why-card {
    border: 1px solid rgba(200,168,130,0.14);
    background: rgba(255,255,255,0.03);
    padding: var(--space-xl);
  }
  .geo-why-num {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    font-weight: 300;
    color: rgba(200,168,130,0.2);
    display: block; line-height: 1;
    margin-bottom: var(--space-sm);
  }
  .geo-why-heading {
    font-family: var(--font-serif);
    font-size: var(--text-title);
    font-weight: 400;
    color: var(--white-warm);
    margin-bottom: var(--space-sm);
  }
  .geo-why-body {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-light);
    line-height: var(--lh-body);
  }

  .geo-faq {
    background: var(--sand-pale);
    padding: var(--space-3xl) 0;
  }
  .geo-faq-container {
    max-width: 760px; margin: 0 auto;
    padding: 0 var(--content-padding);
  }
  .geo-faq-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    margin: var(--space-xs) 0 var(--space-xl);
  }
  .geo-faq-list {
    display: flex; flex-direction: column;
    border-top: 1px solid var(--cream-dark);
  }
  .geo-faq-item { border-bottom: 1px solid var(--cream-dark); }
  .geo-faq-q {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
    padding: var(--space-lg) 0;
    cursor: pointer; list-style: none;
    display: flex; align-items: center;
    justify-content: space-between; gap: var(--space-lg);
    transition: color 200ms ease;
  }
  .geo-faq-q::-webkit-details-marker { display: none; }
  .geo-faq-q::after {
    content: '+'; font-family: var(--font-sans);
    font-size: 18px; font-weight: 300;
    color: var(--warm-sand); flex-shrink: 0;
    transition: transform 300ms ease; line-height: 1;
  }
  .geo-faq-item[open] .geo-faq-q::after { transform: rotate(45deg); }
  .geo-faq-q:hover { color: var(--warm-sand); }
  .geo-faq-a {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 300ms ease;
  }
  .geo-faq-item[open] .geo-faq-a {
    grid-template-rows: 1fr;
  }
  .geo-faq-a p {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: none;
    margin: 0;
    padding-bottom: var(--space-lg);
    overflow: hidden;
    min-height: 0;
  }

  .geo-other-areas {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-lg) var(--content-padding);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-light);
    text-align: center;
    border-top: 1px solid var(--cream-dark);
  }
  .geo-other-label {
    font-size: 9px;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    display: block;
    margin-bottom: var(--space-xs);
  }
  .geo-other-areas a {
    color: var(--stone-mid);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .geo-other-areas a:hover { color: var(--warm-sand); }

  @media (max-width: 1024px) {
    .geo-intro-container { grid-template-columns: 1fr; gap: var(--space-xl); }
    .geo-intro-facts { flex-direction: row; flex-wrap: wrap; }
    .geo-fact { flex: 1; min-width: 150px; }
    .geo-products-grid { grid-template-columns: repeat(2, 1fr); }
    .geo-why-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .geo-products-grid { grid-template-columns: 1fr; }
    .geo-intro-facts { flex-direction: column; }
  }
</style>
