---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTASection from '../components/CTASection.astro';

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you fabricate precast concrete for projects in Toronto?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We fabricate custom precast concrete — sills, caps, keystones, columns, and architectural panels — at our Brampton shop and deliver directly to Toronto residential and commercial sites."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between precast concrete and limestone for a Toronto project?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Precast concrete is cast in moulds and can be finished to simulate limestone's colour and texture at a lower cost, with shorter lead times on repetitive profiles. Natural limestone is quarried stone, priced higher, and preferred where authenticity and natural variation are the priority. Many Toronto projects mix both — natural limestone at focal points, precast for repetitive trim."
      }
    },
    {
      "@type": "Question",
      "name": "Can precast concrete panels be engineered for commercial buildings in Toronto?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We produce full shop drawing packages for commercial precast panels, facade elements, and entrance systems, coordinated with the project's structural engineer for anchorage and load requirements on Toronto commercial and multi-unit builds."
      }
    },
    {
      "@type": "Question",
      "name": "How does precast concrete get delivered to a Toronto job site?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Precast elements ship from our Brampton facility directly to Toronto sites, scheduled around crane availability and site access for larger panels, or standard flatbed delivery for smaller trim pieces."
      }
    }
  ]
});

const localBizSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Tulip Limestone · Precast",
  "description": "Custom precast concrete fabrication for residential and commercial projects in Toronto, Ontario. Sills, caps, columns, and architectural panels.",
  "url": "https://www.tulipstone.ca/precast-concrete-toronto",
  "telephone": "+1-647-534-7755",
  "email": "office@tulipprecast.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "98 Rutherford Rd Unit 2C",
    "addressLocality": "Brampton",
    "addressRegion": "ON",
    "postalCode": "L6W 3J5",
    "addressCountry": "CA"
  },
  "areaServed": {
    "@type": "City",
    "name": "Toronto"
  },
  "priceRange": "$$$"
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.tulipstone.ca" },
    { "@type": "ListItem", "position": 2, "name": "Precast Concrete Toronto", "item": "https://www.tulipstone.ca/precast-concrete-toronto" }
  ]
});

const combinedSchema = JSON.stringify([
  JSON.parse(faqSchema),
  JSON.parse(localBizSchema),
  JSON.parse(breadcrumbSchema),
]);
---

<BaseLayout
  title="Precast Concrete Toronto | Custom Fabrication | Tulip Precast"
  description="Custom precast concrete fabrication for Toronto residential and commercial projects. Sills, caps, columns, and architectural panels, delivered from our Brampton shop. Request a quote."
  pageClass="page-geo-service-toronto-precast"
  solidNav={true}
  additionalSchema={combinedSchema}
>

  <Hero
    size="xs"
    imageSrc="/pictures/column.jpg"
    imageAlt="Custom precast concrete fabrication for Toronto projects — Tulip Limestone Precast"
    eyebrow="TORONTO, ONTARIO · CUSTOM PRECAST FABRICATION"
    headline="Precast Concrete"
    headlineItalic="in Toronto."
    primaryCTA="REQUEST A PRECAST QUOTE"
    primaryCTAHref="/contact?location=toronto&service=precast"
    secondaryCTA="SEE PRECAST CAPABILITIES"
    secondaryCTAHref="/precast"
  />

  <section class="geo-intro" aria-label="Precast concrete services in Toronto">
    <div class="geo-intro-container">
      <div class="geo-intro-text">
        <span class="label-section">Toronto, Ontario · Custom Precast Supply</span>
        <h2 class="geo-intro-headline">Precast concrete fabricated and delivered for Toronto projects.</h2>
        <span class="geo-intro-rule draw-line" aria-hidden="true"></span>
        <p class="geo-intro-body">Tulip Limestone · Precast fabricates custom precast concrete for residential and commercial projects across Toronto — sills, caps, keystones, columns, and architectural panels, cast at our Brampton shop and delivered directly to your site.</p>
        <p class="geo-intro-body">Precast gives Toronto projects a lower-cost, shorter-lead-time alternative to natural stone for repetitive trim, with finish options that range from smooth architectural concrete to textures that closely simulate limestone. See our full <a href="/precast">precast concrete capabilities</a> for the complete process, materials, and specifications.</p>
      </div>
      <div class="geo-intro-facts">
        <div class="geo-fact">
          <span class="geo-fact-val">Custom</span>
          <span class="geo-fact-lbl">Moulds for any repeated profile</span>
        </div>
        <div class="geo-fact">
          <span class="geo-fact-val">Engineered</span>
          <span class="geo-fact-lbl">Shop drawings for commercial work</span>
        </div>
        <div class="geo-fact">
          <span class="geo-fact-val">Direct</span>
          <span class="geo-fact-lbl">Delivery to Toronto, crane-coordinated</span>
        </div>
      </div>
    </div>
  </section>

  <section class="geo-products" aria-label="Precast concrete product range">
    <div class="geo-products-container">
      <span class="label-section">Fabricated for Toronto Projects</span>
      <h2 class="geo-products-title">The precast concrete range.</h2>
      <p class="geo-products-intro">From residential trim to commercial facade panels, cast to specification and finished to match your project.</p>
      <div class="geo-products-grid">
        <a href="/precast" class="geo-product-tile">
          <span class="geo-product-name">Sills &amp; Caps</span>
          <span class="geo-product-desc">Window sills, column caps, and pier caps in cast concrete.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/precast" class="geo-product-tile">
          <span class="geo-product-name">Columns &amp; Keystones</span>
          <span class="geo-product-desc">Classical and custom profiles cast to consistent dimension.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/precast" class="geo-product-tile">
          <span class="geo-product-name">Architectural Panels</span>
          <span class="geo-product-desc">Facade and entrance panels for commercial and multi-unit builds.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone" class="geo-product-tile">
          <span class="geo-product-name">Indiana Limestone</span>
          <span class="geo-product-desc">Natural stone alternative for focal points and entry features.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/gfrc" class="geo-product-tile">
          <span class="geo-product-name">GFRC Panels</span>
          <span class="geo-product-desc">Up to 75% lighter than precast for large facade runs.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/colours" class="geo-product-tile">
          <span class="geo-product-name">Finish &amp; Colour Options</span>
          <span class="geo-product-desc">Smooth architectural finishes through stone-simulating textures.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="geo-why" aria-label="Why Toronto projects choose Tulip precast">
    <div class="geo-why-container">
      <span class="label-section">Why Toronto Projects Choose Tulip Precast</span>
      <h2 class="geo-why-title">Cast to spec, delivered on schedule.</h2>
      <div class="geo-why-grid">
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">01</span>
          <h3 class="geo-why-heading">Custom moulds, in-house</h3>
          <p class="geo-why-body">We build moulds for your specific profile rather than limiting you to a stock catalogue, so repetitive trim matches your elevation drawings exactly.</p>
        </div>
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">02</span>
          <h3 class="geo-why-heading">Engineering coordination</h3>
          <p class="geo-why-body">Commercial panels and facade elements go through shop drawings coordinated with your structural engineer for anchorage, load, and connection details before casting.</p>
        </div>
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">03</span>
          <h3 class="geo-why-heading">Delivery built around your site</h3>
          <p class="geo-why-body">Larger panels are scheduled around crane availability and site access; smaller trim ships standard flatbed. Either way, Toronto delivery is planned around your sequence, not ours.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="geo-faq" aria-label="Frequently asked questions">
    <div class="geo-faq-container">
      <span class="label-section">Common Questions</span>
      <h2 class="geo-faq-title">Toronto Precast — Frequently Asked</h2>
      <div class="geo-faq-list">
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Do you fabricate precast concrete for projects in Toronto?</summary>
          <div class="geo-faq-a"><p>Yes. We fabricate custom precast concrete — sills, caps, keystones, columns, and architectural panels — at our Brampton shop and deliver directly to Toronto residential and commercial sites.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">What is the difference between precast concrete and limestone for a Toronto project?</summary>
          <div class="geo-faq-a"><p>Precast concrete is cast in moulds and can be finished to simulate limestone's colour and texture at a lower cost, with shorter lead times on repetitive profiles. Natural limestone is quarried stone, priced higher, and preferred where authenticity and natural variation are the priority. Many Toronto projects mix both — natural limestone at focal points, precast for repetitive trim.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Can precast concrete panels be engineered for commercial buildings in Toronto?</summary>
          <div class="geo-faq-a"><p>Yes. We produce full shop drawing packages for commercial precast panels, facade elements, and entrance systems, coordinated with the project's structural engineer for anchorage and load requirements on Toronto commercial and multi-unit builds.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">How does precast concrete get delivered to a Toronto job site?</summary>
          <div class="geo-faq-a"><p>Precast elements ship from our Brampton facility directly to Toronto sites, scheduled around crane availability and site access for larger panels, or standard flatbed delivery for smaller trim pieces.</p></div>
        </details>
      </div>
    </div>
  </section>

  <CTASection
    headline="Specifying precast for a Toronto project?"
    subheading="Send us your drawings or concept. We'll quote the profile, finish, and a delivery plan that fits your site."
    buttonText="REQUEST A PRECAST QUOTE"
    buttonHref="/contact?location=toronto&service=precast"
    background="sage"
  />

  <div class="geo-other-areas">
    <span class="geo-other-label">Also serving</span>
    <a href="/toronto">Toronto General</a> ·
    <a href="/brampton">Brampton</a> ·
    <a href="/mississauga">Mississauga</a> ·
    <a href="/oakville">Oakville</a>
  </div>

</BaseLayout>

<style>
  .label-section {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--warm-sand);
    display: block;
    margin-bottom: var(--space-sm);
  }

  .geo-intro {
    background: var(--sand-pale);
    padding: var(--space-3xl) 0;
    border-bottom: 1px solid var(--sand-light);
  }
  .geo-intro-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }
  .geo-intro-headline {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-tight);
    margin: var(--space-xs) 0 var(--space-sm);
  }
  .geo-intro-rule {
    display: block; height: 1px; width: 60px;
    background: var(--sand-light);
    margin-bottom: var(--space-lg);
    transform-origin: left center;
  }
  .geo-intro-body {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: 62ch;
    margin-bottom: var(--space-md);
  }
  .geo-intro-body a {
    color: var(--warm-sand);
    text-decoration: underline;
  }
  .geo-intro-facts {
    display: flex; flex-direction: column;
    gap: var(--space-sm); padding-top: var(--space-md);
  }
  .geo-fact {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    border-left: 3px solid var(--warm-sand);
    padding: var(--space-lg);
    display: flex; flex-direction: column; gap: 4px;
  }
  .geo-fact-val {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 300;
    color: var(--stone-dark); line-height: 1;
  }
  .geo-fact-lbl {
    font-family: var(--font-sans); font-size: 9px;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase; color: var(--stone-light);
  }

  .geo-products {
    padding: var(--space-3xl) 0;
    background: var(--limestone-cream);
  }
  .geo-products-container {
    max-width: var(--max-width);
    margin: 0 auto; padding: 0 var(--content-padding);
  }
  .geo-products-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    margin: var(--space-xs) 0 var(--space-sm);
  }
  .geo-products-intro {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: 60ch;
    margin-bottom: var(--space-xl);
  }
  .geo-products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }
  .geo-product-tile {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    padding: var(--space-lg);
    display: flex; flex-direction: column;
    gap: var(--space-xs);
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .geo-product-tile:hover {
    border-color: var(--warm-sand);
    transform: translateY(-2px);
  }
  .geo-product-name {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
  }
  .geo-product-desc {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    flex: 1;
  }
  .geo-product-arrow {
    font-size: var(--text-body);
    color: var(--sand-light);
    margin-top: var(--space-xs);
    transition: color 200ms ease, transform 200ms ease;
  }
  .geo-product-tile:hover .geo-product-arrow {
    color: var(--warm-sand);
    transform: translateX(4px);
  }

  .geo-why {
    background: var(--quarry-stone);
    padding: var(--space-3xl) 0;
  }
  .geo-why-container {
    max-width: var(--max-width);
    margin: 0 auto; padding: 0 var(--content-padding);
  }
  .geo-why .label-section { color: rgba(200,168,130,0.7); }
  .geo-why-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--white-warm);
    margin: var(--space-xs) 0 var(--space-xl);
  }
  .geo-why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .geo-why-card {
    border: 1px solid rgba(200,168,130,0.14);
    background: rgba(255,255,255,0.03);
    padding: var(--space-xl);
  }
  .geo-why-num {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    font-weight: 300;
    color: rgba(200,168,130,0.2);
    display: block; line-height: 1;
    margin-bottom: var(--space-sm);
  }
  .geo-why-heading {
    font-family: var(--font-serif);
    font-size: var(--text-title);
    font-weight: 400;
    color: var(--white-warm);
    margin-bottom: var(--space-sm);
  }
  .geo-why-body {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-light);
    line-height: var(--lh-body);
  }

  .geo-faq {
    background: var(--sand-pale);
    padding: var(--space-3xl) 0;
  }
  .geo-faq-container {
    max-width: 760px; margin: 0 auto;
    padding: 0 var(--content-padding);
  }
  .geo-faq-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    margin: var(--space-xs) 0 var(--space-xl);
  }
  .geo-faq-list {
    display: flex; flex-direction: column;
    border-top: 1px solid var(--cream-dark);
  }
  .geo-faq-item { border-bottom: 1px solid var(--cream-dark); }
  .geo-faq-q {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
    padding: var(--space-lg) 0;
    cursor: pointer; list-style: none;
    display: flex; align-items: center;
    justify-content: space-between; gap: var(--space-lg);
    transition: color 200ms ease;
  }
  .geo-faq-q::-webkit-details-marker { display: none; }
  .geo-faq-q::after {
    content: '+'; font-family: var(--font-sans);
    font-size: 18px; font-weight: 300;
    color: var(--warm-sand); flex-shrink: 0;
    transition: transform 300ms ease; line-height: 1;
  }
  .geo-faq-item[open] .geo-faq-q::after { transform: rotate(45deg); }
  .geo-faq-q:hover { color: var(--warm-sand); }
  .geo-faq-a {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 300ms ease;
  }
  .geo-faq-item[open] .geo-faq-a {
    grid-template-rows: 1fr;
  }
  .geo-faq-a p {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: none;
    margin: 0;
    padding-bottom: var(--space-lg);
    overflow: hidden;
    min-height: 0;
  }

  .geo-other-areas {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-lg) var(--content-padding);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-light);
    text-align: center;
    border-top: 1px solid var(--cream-dark);
  }
  .geo-other-label {
    font-size: 9px;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    display: block;
    margin-bottom: var(--space-xs);
  }
  .geo-other-areas a {
    color: var(--stone-mid);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .geo-other-areas a:hover { color: var(--warm-sand); }

  @media (max-width: 1024px) {
    .geo-intro-container { grid-template-columns: 1fr; gap: var(--space-xl); }
    .geo-intro-facts { flex-direction: row; flex-wrap: wrap; }
    .geo-fact { flex: 1; min-width: 150px; }
    .geo-products-grid { grid-template-columns: repeat(2, 1fr); }
    .geo-why-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .geo-products-grid { grid-template-columns: 1fr; }
    .geo-intro-facts { flex-direction: column; }
  }
</style>
