---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CTASection from '../components/CTASection.astro';

const categories = [
  {
    id: 'residential',
    label: 'Residential',
    title: 'Residential Precast',
    description: 'For homeowners who want lasting beauty and structural integrity. Our residential precast elements include front porch systems, garden and retaining walls, architectural steps, decorative column bases, and custom exterior elements. Each piece is fabricated to match your project drawings.',
    features: [
      'Front porch systems and platforms',
      'Garden walls and retaining walls',
      'Architectural steps and landings',
      'Decorative column bases and pier caps',
      'Custom exterior accent elements',
    ],
    gradient: 'var(--grad-limestone)',
    imageSrc: '/pictures/Residential.jpg',
    imageAlt: 'Residential precast concrete elements — Tulip Precast Brampton',
    customCTA: true,
  },
  {
    id: 'commercial-industrial',
    label: 'Commercial & Industrial',
    title: 'Commercial & Industrial Precast',
    description: 'Scale, precision, and engineering-grade performance for commercial and industrial construction. Our capabilities span architectural facade elements, building entrance systems, large-format platforms, structural components, and custom precast elements — coordinated with your structural engineer and architect.',
    features: [
      'Architectural facade panels and cladding',
      'Commercial entrance systems and steps',
      'Large-format steps, platforms, and plazas',
      'Structural precast components',
      'High-load capacity specifications',
      'Full shop drawing package included',
    ],
    gradient: 'var(--grad-exterior)',
    imageSrc: '/pictures/stone%20texture%202.jpg',
    imageAlt: 'Commercial and industrial precast concrete — Tulip Precast',
    comingSoon: true,
  },
];

const processSteps = [
  { num: '01', title: 'Contact',       body: 'Email office@tulipprecast.com or call 647-534-7755 with your project details.' },
  { num: '02', title: 'Estimate',      body: 'Submit project information for pricing from our estimating team.' },
  { num: '03', title: 'Shop Drawings', body: 'Our drafting team collaborates with your contractor or architect to address every specification.' },
  { num: '04', title: 'Approval',      body: 'Drawings forwarded to architect or responsible party. Phone confirmation required on return.' },
  { num: '05', title: 'Fabrication',   body: 'Upon receipt of signed proposal and deposit, your project enters our fabrication schedule.' },
  { num: '06', title: 'Delivery',      body: 'Your custom precast elements delivered to site, ready for installation.' },
];
---

<BaseLayout
  title="Precast Concrete Fabrication | GTA | Tulip Precast"
  description="Custom precast concrete in Brampton, ON. Residential, commercial, and industrial elements to specification. Serving the GTA. Ontario Made."
  pageClass="page-precast"
>

  <Hero
    eyebrow="CONCRETE PRECAST · CUSTOM FABRICATION · BRAMPTON, ON"
    headline="Concrete Precast."
    headlineItalic="Precision Built."
    subheading="Custom precast concrete elements for residential, commercial, and industrial projects. Fabricated in Ontario. Delivered across Canada & USA."
    primaryCTA="REQUEST A QUOTE"
    primaryCTAHref="/contact"
    secondaryCTA="VIEW PORTFOLIO"
    secondaryCTAHref="/portfolio?filter=precast"
    size="short"
    backgroundGradient="var(--grad-product)"
    imageSrc="/pictures/lifestyle.jpg"
    imageAlt="Precast concrete texture — Tulip Precast custom fabrication"
  />

  <!-- Category sections -->
  <div class="precast-content">
    <div class="container">

      {categories.map((cat, i) => (
        <section id={cat.id} class="precast-section reveal" aria-label={cat.title}>
          <div class={`precast-grid ${i % 2 === 1 ? 'precast-grid--reverse' : ''}`}>
            <div class="precast-image reveal">
              {cat.imageSrc ? (
                <img
                  src={cat.imageSrc}
                  alt={cat.imageAlt || cat.title}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                  class="precast-real-img"
                />
              ) : (
                <div class="precast-placeholder" style={`background: ${cat.gradient}`} aria-hidden="true">
                  <span class="placeholder-label">[ Photography ]</span>
                </div>
              )}
            </div>
            <div class="precast-text">
              <p class="section-label precast-label">{cat.label}</p>
              <h2 class="precast-title">{cat.title}</h2>
              <div class="draw-line precast-rule" aria-hidden="true"></div>
              <p class="precast-description">{cat.description}</p>
              <ul class="precast-features" role="list">
                {cat.features.map((f) => (
                  <li class="precast-feature-item">
                    <span class="feature-mark" aria-hidden="true">—</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
              {cat.customCTA && (
                <div class="precast-custom-cta">
                  <span class="precast-custom-cta-label">We Can Make What You Want</span>
                  <p class="precast-custom-cta-body">Have a unique design in mind? Bring us any idea — sketch, photo, or drawing — and we'll fabricate it exactly to your specification.</p>
                  <a href="/contact?product=custom-residential" class="btn btn-outlined-dark btn-magnetic">
                    Tell Us About Your Project
                  </a>
                </div>
              )}
              {cat.comingSoon ? (
                <span class="btn btn-primary" style="opacity:0.5;cursor:default;pointer-events:none;letter-spacing:var(--ls-wider);">Coming Soon</span>
              ) : (
                <a href={`/contact?product=${cat.id}-precast`} class="btn btn-primary btn-magnetic">
                  Request a Quote for {cat.title}
                </a>
              )}
            </div>
          </div>
        </section>
      ))}

      <!-- Installation section -->
      <section id="installation" class="precast-install">
        <SectionHeader
          label="On-Site Installation"
          title="From Shop Drawing to"
          titleItalic="Finished Install."
          subtitle="Every precast element — from a single step to a full facade system — follows the same disciplined installation sequence."
          align="center"
        />
        <div class="precast-install-steps">
          <div class="precast-install-step reveal">
            <span class="precast-install-num">01</span>
            <h3 class="precast-install-step-title">Site Prepared</h3>
            <p class="precast-install-step-body">The base or footing is prepared and confirmed level per your engineered drawings before any element arrives on site.</p>
          </div>
          <div class="precast-install-step reveal">
            <span class="precast-install-num">02</span>
            <h3 class="precast-install-step-title">Element Set</h3>
            <p class="precast-install-step-body">Smaller elements — steps, sills, caps — are hand-set and shimmed. Larger architectural and structural pieces are set by crane or forklift per the rigging plan in your shop drawings.</p>
          </div>
          <div class="precast-install-step reveal">
            <span class="precast-install-num">03</span>
            <h3 class="precast-install-step-title">Levelled &amp; Anchored</h3>
            <p class="precast-install-step-body">Elements are levelled and anchored per the connection details in your engineered drawings — dowelled, bolted, or grouted as specified.</p>
          </div>
          <div class="precast-install-step reveal">
            <span class="precast-install-num">04</span>
            <h3 class="precast-install-step-title">Joints Finished</h3>
            <p class="precast-install-step-body">Joints are pointed, caulked, or grouted to match the specified finish, and exposed hardware is capped or concealed.</p>
          </div>
        </div>
      </section>

      <!-- Materials & finishes section -->
      <section id="materials" class="precast-materials">
        <SectionHeader
          label="Materials &amp; Finishes"
          title="Strength and Surface,"
          titleItalic="Specified to Fit."
          subtitle="Every element is reinforced, structural-grade concrete — the finish is where the design decisions happen."
          align="center"
        />
        <div class="precast-materials-grid">
          <div class="precast-material-card reveal">
            <h3 class="precast-material-name">Smooth Form Finish</h3>
            <p class="precast-material-desc">The standard finish — a clean, uniform surface straight from the form. The most economical option and the right choice when the element will be painted, clad, or hidden from view.</p>
          </div>
          <div class="precast-material-card reveal">
            <h3 class="precast-material-name">Exposed Aggregate</h3>
            <p class="precast-material-desc">Decorative stone aggregate revealed at the surface through retardation and washing — adds texture, visual interest, and slip resistance on steps and treads.</p>
          </div>
          <div class="precast-material-card reveal">
            <h3 class="precast-material-name">Acid-Etched Finish</h3>
            <p class="precast-material-desc">A subtler surface texture than exposed aggregate — a refined matte finish suited to formal residential and commercial applications.</p>
          </div>
          <div class="precast-material-card reveal">
            <h3 class="precast-material-name">Integral Colour</h3>
            <p class="precast-material-desc">Pigment mixed through the full depth of the concrete — not a surface coating — so colour does not chip, peel, or fade with weathering.</p>
          </div>
        </div>
      </section>

      <!-- Sizing & specs section -->
      <section id="specs" class="precast-specs">
        <SectionHeader
          label="Sizing &amp; Specifications"
          title="Typical Precast"
          titleItalic="Dimensions."
          align="center"
        />
        <p class="precast-specs-intro">The figures below reflect typical production ranges. Load-bearing and structural elements are sized and reinforced per your structural engineer's specifications — these are starting points for budgeting, not fixed stock sizes.</p>
        <table class="precast-specs-table">
          <tbody>
            <tr><td class="precast-spec-key">Concrete Strength</td><td class="precast-spec-value">35 MPa or higher, reinforced</td></tr>
            <tr><td class="precast-spec-key">Standard Step Rise</td><td class="precast-spec-value">7" (178mm) typical</td></tr>
            <tr><td class="precast-spec-key">Standard Step Tread</td><td class="precast-spec-value">11"–12" typical</td></tr>
            <tr><td class="precast-spec-key">Platform / Slab Thickness</td><td class="precast-spec-value">4"–6" standard; engineered thicker for vehicular loads</td></tr>
            <tr><td class="precast-spec-key">Reinforcement</td><td class="precast-spec-value">Rebar-reinforced; galvanized or epoxy-coated available</td></tr>
            <tr><td class="precast-spec-key">Custom Dimensions</td><td class="precast-spec-value">Any size or profile to engineered specification</td></tr>
          </tbody>
        </table>
      </section>

      <!-- FAQ section -->
      <section id="faq" class="precast-faq">
        <SectionHeader
          label="Common Questions"
          title="Frequently Asked"
          titleItalic="Questions."
          align="center"
        />
        <div class="precast-faq-list">
          <details class="precast-faq-item">
            <summary class="precast-faq-question">What precast concrete products does Tulip Precast fabricate?</summary>
            <div class="precast-faq-answer"><p>We fabricate a wide range of precast elements for residential, commercial, and industrial applications — including steps, lintels, sills, caps, pads, retaining wall blocks, light pole bases, and custom structural elements.</p></div>
          </details>
          <details class="precast-faq-item">
            <summary class="precast-faq-question">Can you match custom dimensions and profiles for precast concrete?</summary>
            <div class="precast-faq-answer"><p>Yes. All precast products can be fabricated to custom dimensions, profiles, and finishes. Provide your drawings or specifications and we will quote accordingly.</p></div>
          </details>
          <details class="precast-faq-item">
            <summary class="precast-faq-question">What is custom precast concrete and how is it different from standard precast?</summary>
            <div class="precast-faq-answer"><p>Custom precast concrete is fabricated from your specific drawings, dimensions, and design intent rather than a standard catalogue mould. At Tulip Precast, every custom order — whether a one-off architectural element or a full production run — begins with shop drawings produced by our in-house drafting team, so the finished product matches your project exactly rather than approximating a stock size.</p></div>
          </details>
          <details class="precast-faq-item">
            <summary class="precast-faq-question">Do you fabricate precast limestone panels or cast stone?</summary>
            <div class="precast-faq-answer"><p>Yes. Precast concrete can be finished with integral pigment, aggregate exposure, and surface texturing to closely simulate natural Indiana Limestone — commonly called cast stone. For projects that call for true natural stone, we also fabricate genuine Indiana Limestone elements, and for lightweight architectural panels we produce GFRC, which is up to 75% lighter than standard precast and can also be finished to simulate limestone. Contact us to discuss which material fits your project and budget.</p></div>
          </details>
          <details class="precast-faq-item">
            <summary class="precast-faq-question">What is the delivery area for precast products?</summary>
            <div class="precast-faq-answer"><p>We deliver throughout the Greater Toronto Area and surrounding regions, including Brampton, Mississauga, Oakville, Burlington, Hamilton, Toronto, Vaughan, and Markham. Contact us for delivery pricing and scheduling.</p></div>
          </details>
          <details class="precast-faq-item">
            <summary class="precast-faq-question">What concrete strength do you use for precast elements?</summary>
            <div class="precast-faq-answer"><p>Our precast elements are fabricated with 35 MPa or higher compressive strength concrete, meeting or exceeding CSA standards for structural precast applications.</p></div>
          </details>
          <details class="precast-faq-item">
            <summary class="precast-faq-question">Do you handle large commercial or industrial precast orders?</summary>
            <div class="precast-faq-answer"><p>Yes. We are equipped for commercial and industrial precast fabrication including large-format elements, high-volume runs, and project-specific requirements. Contact us to discuss your project.</p></div>
          </details>
        </div>
      </section>

      <div class="precast-other-services">
        <span class="precast-other-services-label">Building in Toronto?</span>
        <a href="/precast-concrete-toronto">See our dedicated Precast Concrete in Toronto page</a>
      </div>

      <!-- Process section -->
      <section id="process" class="process-section">
        <SectionHeader
          label="Our Process"
          title="How Ordering Works."
          subtitle="From first contact to delivery — a clear, coordinated process that protects your timeline and budget."
          align="center"
        />

        <div class="process-timeline">
          {processSteps.map((step, i) => (
            <div class="process-step reveal" style={`transition-delay: ${i * 80}ms`}>
              <div class="process-step-number">{step.num}</div>
              <div class="process-step-connector" aria-hidden="true"></div>
              <h3 class="process-step-title">{step.title}</h3>
              <p class="process-step-body">{step.body}</p>
            </div>
          ))}
        </div>
      </section>

    </div>
  </div>

  <CTASection
    background="dark"
    headline="Need a precast estimate?"
    subheading="Submit your drawings or project details and our team will prepare a comprehensive quotation."
    buttonText="REQUEST A QUOTE"
    buttonHref="/contact"
  />

</BaseLayout>

<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }

  .precast-content {
    background: var(--limestone-cream);
    padding: var(--space-2xl) 0;
  }

  .precast-section {
    padding: var(--space-2xl) 0;
    border-bottom: 1px solid var(--sand-light);
  }

  /* ── Content grid ──────────────────────────────────── */

  .precast-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  .precast-grid--reverse {
    direction: rtl;
  }

  .precast-grid--reverse > * {
    direction: ltr;
  }

  .precast-image {
    overflow: hidden;
  }

  .precast-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .precast-real-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .precast-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .precast-label {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--warm-sand);
    max-width: none;
  }

  .precast-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 400;
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-tight);
    color: var(--stone-dark);
  }

  .precast-rule {
    width: 40px;
    height: 1px;
    background: var(--warm-sand);
  }

  .precast-description {
    font-size: var(--text-body);
    line-height: var(--lh-body);
    color: var(--stone-mid);
    max-width: 55ch;
  }

  .precast-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .precast-feature-item {
    display: flex;
    gap: var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
  }

  .feature-mark {
    color: var(--warm-sand);
    flex-shrink: 0;
  }

  /* ── Custom CTA callout ────────────────────────────── */

  .precast-custom-cta {
    background: var(--cream-dark);
    border-left: 3px solid var(--warm-sand);
    padding: var(--space-md) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .precast-custom-cta-label {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
    line-height: var(--lh-heading);
    font-style: italic;
  }

  .precast-custom-cta-body {
    font-size: var(--text-small);
    line-height: var(--lh-body);
    color: var(--stone-mid);
    max-width: 48ch;
  }

  /* ── Installation section ─────────────────────────── */

  .precast-install {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--sand-light);
  }

  .precast-install-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .precast-install-step {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-top: var(--space-md);
    border-top: 1px solid var(--sand-light);
  }

  .precast-install-num {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 300;
    color: var(--warm-sand);
    line-height: 1;
    letter-spacing: var(--ls-tight);
  }

  .precast-install-step-title {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--stone-dark);
  }

  .precast-install-step-body {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    line-height: var(--lh-body);
    color: var(--stone-mid);
    max-width: none;
  }

  /* ── Materials & finishes section ─────────────────── */

  .precast-materials {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--sand-light);
  }

  .precast-materials-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .precast-material-card {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    border-left: 3px solid var(--warm-sand);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .precast-material-name {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
    line-height: var(--lh-heading);
  }

  .precast-material-desc {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: none;
  }

  /* ── Sizing & specs section ───────────────────────── */

  .precast-specs {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--sand-light);
  }

  .precast-specs-intro {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    font-style: italic;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: 640px;
    margin: 0 auto var(--space-lg);
    text-align: center;
  }

  .precast-specs-table {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    border-collapse: collapse;
  }

  .precast-specs-table tr {
    border-bottom: 1px solid var(--cream-dark);
  }

  .precast-specs-table tr:first-child {
    border-top: 1px solid var(--cream-dark);
  }

  .precast-spec-key {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--stone-light);
    padding: var(--space-sm) 0;
    width: 45%;
    vertical-align: top;
  }

  .precast-spec-value {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 400;
    color: var(--stone-dark);
    padding: var(--space-sm) 0;
  }

  /* ── FAQ section ───────────────────────────────────── */

  .precast-faq {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--sand-light);
  }

  .precast-faq-list {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--cream-dark);
  }

  .precast-faq-item {
    border-bottom: 1px solid var(--cream-dark);
  }

  .precast-faq-item[open] {
    background: var(--white-warm);
  }

  .precast-faq-question {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
    padding: var(--space-lg) 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    transition: color 200ms ease;
  }

  .precast-faq-question::-webkit-details-marker { display: none; }

  .precast-faq-question::after {
    content: '+';
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 300;
    color: var(--warm-sand);
    flex-shrink: 0;
    transition: transform 300ms ease;
    line-height: 1;
  }

  .precast-faq-item[open] .precast-faq-question::after {
    transform: rotate(45deg);
  }

  .precast-faq-question:hover { color: var(--warm-sand); }

  .precast-faq-answer {
    padding: 0 0 var(--space-lg);
  }

  .precast-faq-answer p {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: none;
    margin: 0;
  }

  .precast-other-services {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-lg) var(--content-padding);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-light);
    text-align: center;
    border-top: 1px solid var(--cream-dark);
  }
  .precast-other-services-label {
    font-size: 9px;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    display: block;
    margin-bottom: var(--space-xs);
  }
  .precast-other-services a {
    color: var(--stone-mid);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .precast-other-services a:hover {
    color: var(--warm-sand);
  }

  /* ── Process ───────────────────────────────────────── */

  .process-section {
    padding: var(--space-2xl) 0;
  }

  .process-timeline {
    display: grid;
