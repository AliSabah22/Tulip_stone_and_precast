---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ProductSection from '../../components/limestone/ProductSection.astro';
import CTASection from '../../components/CTASection.astro';

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the difference between a slip sill and a lug sill?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A slip sill sits flush within the masonry opening — the same width as the window frame. A lug sill projects beyond the window frame and extends into the masonry on both sides, allowing for a full surround system and more pronounced architectural presence. Tulip Precast fabricates both types in Indiana Limestone in a range of profiles."
      }
    },
    {
      "@type": "Question",
      "name": "What limestone sill profiles does Tulip Precast offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tulip Precast fabricates Indiana Limestone sills in five standard profiles: Classic Slip Sill, Classic Bull Nose Sill, Conventional Sill, Double Slope Sill, and Conventional Sill with Lip. Custom profiles are also available for heritage matching and contemporary designs."
      }
    },
    {
      "@type": "Question",
      "name": "Can limestone sills be combined with door and window surrounds?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. A lug sill combined with jambs and a head surround creates a complete architectural window system — the most refined option available. Tulip Precast fabricates all components as a matched set with custom shop drawings."
      }
    },
    {
      "@type": "Question",
      "name": "Do limestone sills perform well in Ontario's climate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Indiana Limestone performs reliably through hundreds of freeze-thaw cycles without cracking or spalling and has been used on some of Canada's most prominent buildings for over a century. Tulip Precast sills are fabricated from the same high-quality Indiana Limestone used in institutional and commercial buildings across the GTA."
      }
    },
    {
      "@type": "Question",
      "name": "What is the standard thickness for Indiana Limestone sills?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tulip Precast fabricates Indiana Limestone sills in a standard 2 inch thickness, with lug sills available up to 4 inches for a more substantial profile. Exact dimensions — length, projection, and slope — are confirmed for your specific opening during the custom shop drawing stage, so every sill fits precisely."
      }
    },
    {
      "@type": "Question",
      "name": "Are Indiana Limestone window sills better than precast or cast stone sills?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Indiana Limestone is a natural quarried stone, not a manufactured product, which means it will not fade, chip its finish, or expose aggregate the way cast or cultured stone can over time, and it has a proven weathering record spanning more than a century of North American construction. Precast and cast stone sills are generally more economical for large-volume commercial runs; for residential and heritage-sensitive projects, natural Indiana Limestone is usually the preferred specification."
      }
    }
  ]
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.tulipstone.ca" },
    { "@type": "ListItem", "position": 2, "name": "Limestone Products", "item": "https://www.tulipstone.ca/limestone" },
    { "@type": "ListItem", "position": 3, "name": "Sills", "item": "https://www.tulipstone.ca/limestone/sills" }
  ]
});

const combinedSchema = JSON.stringify([
  JSON.parse(faqSchema),
  JSON.parse(breadcrumbSchema),
]);
---

<BaseLayout
  title="Limestone Window Sills Toronto | Slip & Lug Sills | Tulip"
  description="Indiana Limestone window sills for Toronto and the GTA. Slip sills, lug sills, and custom profiles. Classic, Bull Nose, Conventional, and Double Slope styles. Ontario Made. Custom shop drawings on every order."
  pageClass="page-limestone-sills"
  solidNav={true}
  additionalSchema={combinedSchema}
>

  <Hero
    size="xs"
    imageSrc="/pictures/window.jpg"
    imageAlt="Indiana Limestone window sill and surround on residential masonry facade, Greater Toronto Area — Tulip Precast Brampton Ontario"
    eyebrow="INDIANA LIMESTONE · SILLS · ONTARIO MADE"
    headline="Limestone Window Sills."
    headlineItalic="Slip Sill or Lug Sill Profiles."
    primaryCTA="REQUEST A QUOTE"
    primaryCTAHref="/contact?product=sills"
    secondaryCTA="VIEW ALL LIMESTONE"
    secondaryCTAHref="/limestone"
  />

  <section class="plp-intro" aria-label="Sills overview">
    <div class="plp-intro-container">
      <div class="plp-intro-content">
        <span class="label-section">Indiana Limestone · Window Sills</span>
        <h2 class="plp-intro-headline">Limestone sills for every opening in the GTA.</h2>
        <span class="plp-intro-rule draw-line" aria-hidden="true"></span>
        <p class="plp-intro-body">Indiana Limestone window sills are among the most specified architectural elements in residential and commercial masonry across Ontario — a subtle but essential detail that elevates the appearance of any brick or stone facade. At Tulip Precast in Brampton, we fabricate both slip sills and lug sills in five standard profiles, plus custom sizes and heritage profiles for non-standard applications.</p>
        <p class="plp-intro-body">Whether you need a simple slip sill flush with the masonry opening, or a full lug sill system that extends into the masonry for maximum architectural presence, every sill we produce is fabricated with custom shop drawings and produced in Indiana Limestone — the same material used on some of Canada's most celebrated buildings.</p>
      </div>
      <div class="plp-intro-facts">
        <div class="plp-fact">
          <span class="plp-fact-val">5</span>
          <span class="plp-fact-lbl">Standard sill profiles</span>
        </div>
        <div class="plp-fact">
          <span class="plp-fact-val">2</span>
          <span class="plp-fact-lbl">Types — Slip Sill &amp; Lug Sill</span>
        </div>
        <div class="plp-fact">
          <span class="plp-fact-val">Custom</span>
          <span class="plp-fact-lbl">Heritage and non-standard profiles</span>
        </div>
      </div>
    </div>
  </section>

  <ProductSection
    id="sills"
    num="08"
    label="Limestone · Architectural"
    title="Sills"
    imageSrc="/pictures/Limestone%20page%20images/sills.png"
    imageAlt="Indiana limestone classic slip sill profile, Tulip Precast"
    imagePosition="center center"
    description="Sills are among the most essential architectural elements — adding understated style to any project. Slip sills are designed to align seamlessly with the width of the masonry opening. Lug sills extend beyond the window, allowing for the installation of a full surround and a more pronounced architectural presence. Custom sills are also available."
    callout={{ label: 'Slip Sill vs Lug Sill', body: 'Slip sills sit flush within the masonry opening. Lug sills project beyond the window frame — use a lug sill when installing a full surround system for the most architecturally complete result.' }}
    variants={[
      { name: 'Classic Slip Sill',          description: 'Flush with opening, clean simple profile',    imageSrc: '/pictures/sills/Classic%20Slip%20Sill.png' },
      { name: 'Classic Bull Nose Sill',     description: 'Rounded leading edge, softened profile',      imageSrc: '/pictures/sills/classic%20Bull%20Nose%20sill.png' },
      { name: 'Conventional Sill',          description: 'Sloped top, standard drainage profile',       imageSrc: '/pictures/sills/Conventional%20Sill.png' },
      { name: 'Double Slope Sill',          description: 'Dual pitch top, enhanced water runoff',       imageSrc: '/pictures/sills/Double%20Slope%20Sill.png' },
      { name: 'Conventional Sill with Lip', description: 'Standard slope with drip-edge lip detail',   imageSrc: '/pictures/sills/Conventional%20Sill%20With%20Lip.png' },
      { name: 'Custom',                     description: 'Any profile to specification' },
    ]}
    flip={true}
  />

  <section class="plp-install" aria-label="Installation process">
    <div class="plp-install-container">
      <span class="label-section">How It's Installed</span>
      <h2 class="plp-install-title">From shop drawing to finished opening.</h2>
      <div class="plp-install-steps">
        <div class="plp-install-step">
          <span class="plp-install-num">01</span>
          <h3 class="plp-install-step-title">Opening Measured &amp; Confirmed</h3>
          <p class="plp-install-step-body">Your mason or contractor confirms the rough opening width. We produce custom shop drawings for approval before any stone is cut, so the sill is sized precisely for your masonry opening — not a stock size trimmed on site.</p>
        </div>
        <div class="plp-install-step">
          <span class="plp-install-num">02</span>
          <h3 class="plp-install-step-title">Mortar Bed &amp; Flashing</h3>
          <p class="plp-install-step-body">The sill sets on a full mortar bed over the rough opening, with through-wall flashing beneath to direct any moisture that reaches the cavity back out past the masonry face — standard practice for long-term performance in Ontario's freeze-thaw climate.</p>
        </div>
        <div class="plp-install-step">
          <span class="plp-install-num">03</span>
          <h3 class="plp-install-step-title">Slope &amp; Drip Set</h3>
          <p class="plp-install-step-body">Every sill profile is cut with a wash slope so water sheds away from the window frame, and lug sill profiles include a drip groove on the underside so water cannot track back along the sill into the masonry below.</p>
        </div>
        <div class="plp-install-step">
          <span class="plp-install-num">04</span>
          <h3 class="plp-install-step-title">Joints Sealed</h3>
          <p class="plp-install-step-body">End joints and the window-to-sill interface are sealed with a flexible, paintable sealant rather than rigid mortar, allowing for normal thermal movement without cracking the joint over time.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="plp-materials" aria-label="Materials and finish options">
    <div class="plp-materials-container">
      <span class="label-section">Materials &amp; Finishes</span>
      <h2 class="plp-materials-title">Colour and surface, matched to your facade.</h2>
      <p class="plp-materials-intro">Sills are most commonly specified in the Buff or Gray colour families to complement brick or stone veneer, though any colour in our full palette is available.</p>
      <div class="plp-materials-grid">
        <div class="plp-material-card">
          <h3 class="plp-material-name">Buff Family</h3>
          <p class="plp-material-desc">Standard Buff, Silver Buff, and Northern Buff — warm golden tones that pair naturally with red and brown brick. The most traditional choice for GTA residential facades.</p>
        </div>
        <div class="plp-material-card">
          <h3 class="plp-material-name">Gray Family</h3>
          <p class="plp-material-desc">Standard Gray, Northern Gray, and Rustic Gray — cooler, more contemporary tones suited to grey or buff brick and modern masonry.</p>
        </div>
        <div class="plp-material-card">
          <h3 class="plp-material-name">Smooth Sawn Finish</h3>
          <p class="plp-material-desc">The standard finish on every sill — a clean, consistent sawn surface with crisp arrises on the profile edges.</p>
        </div>
        <div class="plp-material-card">
          <h3 class="plp-material-name">Honed Finish</h3>
          <p class="plp-material-desc">Available on select colours for a smoother, more refined surface texture — a common upgrade on formal entrances and heritage matching work.</p>
        </div>
      </div>
      <a href="/colours" class="plp-materials-link">View the full Indiana Limestone colour palette →</a>
    </div>
  </section>

  <section class="plp-specs" aria-label="Sizing and specifications">
    <div class="plp-specs-container">
      <span class="label-section">Sizing &amp; Specifications</span>
      <h2 class="plp-specs-title">Typical sill dimensions.</h2>
      <p class="plp-specs-intro">The figures below reflect typical production ranges. Every sill is sized to your exact opening during the shop drawing stage — these are starting points for budgeting and specification, not fixed stock sizes.</p>
      <table class="plp-specs-table">
        <tbody>
          <tr><td class="plp-spec-key">Standard Thickness</td><td class="plp-spec-value">2" (51mm)</td></tr>
          <tr><td class="plp-spec-key">Lug Sill Thickness (upgraded)</td><td class="plp-spec-value">Up to 4" (102mm)</td></tr>
          <tr><td class="plp-spec-key">Lug Sill Projection</td><td class="plp-spec-value">1.5"–2" beyond masonry face, each side</td></tr>
          <tr><td class="plp-spec-key">Slip Sill Length</td><td class="plp-spec-value">Cut flush to rough opening width</td></tr>
          <tr><td class="plp-spec-key">Wash Slope</td><td class="plp-spec-value">Standard drainage slope on all profiles</td></tr>
          <tr><td class="plp-spec-key">Drip Groove</td><td class="plp-spec-value">Standard on lug sill profiles</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="plp-faq" aria-label="Frequently asked questions">
    <div class="plp-faq-container">
      <span class="label-section">Common Questions</span>
      <h2 class="plp-faq-title">Frequently Asked Questions</h2>
      <div class="plp-faq-list">
        <details class="plp-faq-item">
          <summary class="plp-faq-question">What is the difference between a slip sill and a lug sill?</summary>
          <div class="plp-faq-answer"><p>A slip sill sits flush within the masonry opening — the same width as the window frame. A lug sill projects beyond the window frame and extends into the masonry on both sides, allowing for a full surround system and more pronounced architectural presence. Tulip Precast fabricates both types in Indiana Limestone in a range of profiles.</p></div>
        </details>
        <details class="plp-faq-item">
          <summary class="plp-faq-question">What limestone sill profiles does Tulip Precast offer?</summary>
          <div class="plp-faq-answer"><p>Tulip Precast fabricates Indiana Limestone sills in five standard profiles: Classic Slip Sill, Classic Bull Nose Sill, Conventional Sill, Double Slope Sill, and Conventional Sill with Lip. Custom profiles are also available for heritage matching and contemporary designs.</p></div>
        </details>
        <details class="plp-faq-item">
          <summary class="plp-faq-question">Can limestone sills be combined with surrounds?</summary>
          <div class="plp-faq-answer"><p>Yes. A lug sill combined with jambs and a head surround creates a complete architectural window system — the most refined option available. Tulip Precast fabricates all components as a matched set with custom shop drawings.</p></div>
        </details>
        <details class="plp-faq-item">
          <summary class="plp-faq-question">Do limestone sills perform well in Ontario's climate?</summary>
          <div class="plp-faq-answer"><p>Yes. Indiana Limestone performs reliably through hundreds of freeze-thaw cycles without cracking or spalling and has been used on some of Canada's most prominent buildings for over a century. Tulip Precast sills are fabricated from the same high-quality Indiana Limestone used in institutional and commercial buildings across the GTA.</p></div>
        </details>
        <details class="plp-faq-item">
          <summary class="plp-faq-question">What is the standard thickness for Indiana Limestone sills?</summary>
          <div class="plp-faq-answer"><p>Tulip Precast fabricates Indiana Limestone sills in a standard 2 inch thickness, with lug sills available up to 4 inches for a more substantial profile. Exact dimensions — length, projection, and slope — are confirmed for your specific opening during the custom shop drawing stage, so every sill fits precisely.</p></div>
        </details>
        <details class="plp-faq-item">
          <summary class="plp-faq-question">Are Indiana Limestone window sills better than precast or cast stone sills?</summary>
          <div class="plp-faq-answer"><p>Indiana Limestone is a natural quarried stone, not a manufactured product, which means it will not fade, chip its finish, or expose aggregate the way cast or cultured stone can over time, and it has a proven weathering record spanning more than a century of North American construction. Precast and cast stone sills are generally more economical for large-volume commercial runs; for residential and heritage-sensitive projects, natural Indiana Limestone is usually the preferred specification.</p></div>
        </details>
      </div>
    </div>
  </section>

  <section class="plp-related" aria-label="Related limestone products">
    <div class="plp-related-container">
      <span class="label-section">Also From Tulip Limestone</span>
      <div class="plp-related-grid">
        <a href="/limestone/columns" class="plp-related-tile">
          <span class="plp-related-name">Limestone Columns</span>
          <span class="plp-related-arrow">→</span>
        </a>
        <a href="/limestone/carving" class="plp-related-tile">
          <span class="plp-related-name">Custom Limestone Carving</span>
          <span class="plp-related-arrow">→</span>
        </a>
        <a href="/limestone" class="plp-related-tile plp-related-tile--all">
          <span class="plp-related-name">All Limestone Products</span>
          <span class="plp-related-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <CTASection
    headline="Ready to specify Window Sills?"
    subheading="Send us your drawings and specifications. Our team will respond within one business day."
    buttonText="REQUEST A FREE QUOTE"
    buttonHref="/contact?product=sills"
    background="sage"
  />

</BaseLayout>

<style>

  .label-section {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--warm-sand);
    display: block;
    margin-bottom: var(--space-sm);
  }

  /* ── Intro ───────────────────────────────────────────────── */

  .plp-intro {
    background: var(--sand-pale);
    padding: var(--space-3xl) 0;
    border-bottom: 1px solid var(--sand-light);
  }

  .plp-intro-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .plp-intro-headline {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-tight);
    margin: var(--space-xs) 0 var(--space-sm);
  }

  .plp-intro-rule {
    display: block;
    height: 1px;
    background: var(--sand-light);
    width: 60px;
    margin-bottom: var(--space-lg);
    transform-origin: left center;
  }

  .plp-intro-body {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: 62ch;
    margin-bottom: var(--space-md);
  }

  /* ── Fact pills ───────────────────────────────────────────── */

  .plp-intro-facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-top: var(--space-md);
  }

  .plp-fact {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    border-left: 3px solid var(--warm-sand);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .plp-fact-val {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 300;
    color: var(--stone-dark);
    line-height: 1;
  }

  .plp-fact-lbl {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--stone-light);
  }

  /* ── Installation process ───────────────────────────────────── */

  .plp-install {
    background: var(--limestone-cream);
    padding: var(--space-3xl) 0;
    border-top: 1px solid var(--cream-dark);
  }

  .plp-install-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }

  .plp-install-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    margin: var(--space-xs) 0 var(--space-xl);
    line-height: var(--lh-heading);
  }

  .plp-install-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .plp-install-step {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-top: var(--space-md);
    border-top: 1px solid var(--sand-light);
  }

  .plp-install-num {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 300;
    color: var(--warm-sand);
    line-height: 1;
    letter-spacing: var(--ls-tight);
  }

  .plp-install-step-title {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--stone-dark);
  }

  .plp-install-step-body {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    line-height: var(--lh-body);
    color: var(--stone-mid);
    max-width: none;
  }

  /* ── Materials & finishes ────────────────────────────────────── */

  .plp-materials {
    background: var(--sand-pale);
    padding: var(--space-3xl) 0;
    border-top: 1px solid var(--sand-light);
  }

  .plp-materials-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }

  .plp-materials-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    margin: var(--space-xs) 0 var(--space-sm);
    line-height: var(--lh-heading);
  }

  .plp-materials-intro {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: 62ch;
    margin-bottom: var(--space-xl);
  }

  .plp-materials-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .plp-material-card {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    border-left: 3px solid var(--warm-sand);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .plp-material-name {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
    line-height: var(--lh-heading);
  }

  .plp-material-desc {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: none;
  }

  .plp-materials-link {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 400;
    color: var(--warm-sand);
    transition: color 200ms ease;
  }

  .plp-materials-link:hover {
    color: var(--stone-dark);
  }

  /* ── Sizing & specs ───────────────────────────────────────────── */

  .plp-specs {
    background: var(--limestone-cream);
    padding: var(--space-3xl) 0;
    border-top: 1px solid var(--cream-dark);
  }

  .plp-specs-container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }

  .plp-specs-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    margin: var(--space-xs) 0 var(--space-sm);
    line-height: var(--lh-heading);
  }

  .plp-specs-intro {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    font-style: italic;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    margin-bottom: var(--space-lg);
  }

  .plp-specs-table {
    width: 100%;
    border-collapse: collapse;
  }

  .plp-specs-table tr {
    border-bottom: 1px solid var(--cream-dark);
  }

  .plp-specs-table tr:first-child {
    border-top: 1px solid var(--cream-dark);
  }

  .plp-spec-key {
    font-family: var(--font-sans);
