---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ProductSection from '../../components/limestone/ProductSection.astro';
import CTASection from '../../components/CTASection.astro';

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What can be carved in Indiana Limestone?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Indiana Limestone can be carved into virtually any architectural ornament or sculptural form — including column capitals, keystones, door surround ornaments, heraldic shields, lettering, decorative friezes, garden sculptures, and full figurative commissions. Tulip Precast produces custom limestone carvings from client drawings for residential and commercial projects across Ontario."
      }
    },
    {
      "@type": "Question",
      "name": "Can you replicate existing limestone carvings for a heritage restoration?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Tulip Precast specialises in heritage replica carving — producing exact matches for damaged or deteriorated limestone ornaments. Please provide drawings and specifications, full-size layouts if available, and photographs and measurements of the existing piece."
      }
    },
    {
      "@type": "Question",
      "name": "What do I need to provide when ordering a custom limestone carving?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When ordering a custom limestone carving, please provide: drawings and specifications, full-size layouts if available, and — for replica work — photographs and measurements of the existing piece. Contact us at office@tulipprecast.com or 647-534-7755 to begin the consultation."
      }
    },
    {
      "@type": "Question",
      "name": "Why is Indiana Limestone the preferred material for architectural carving?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Indiana Limestone is a favourite among architectural carvers because of its workability — it cuts cleanly, holds fine detail well, and does not splinter under carving tools. It retains carved detail over centuries, which is why it was chosen for the Empire State Building and the National Cathedral."
      }
    }
  ]
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.tulipprecast.com" },
    { "@type": "ListItem", "position": 2, "name": "Limestone Products", "item": "https://www.tulipprecast.com/limestone" },
    { "@type": "ListItem", "position": 3, "name": "Custom Limestone Carving", "item": "https://www.tulipprecast.com/limestone/carving" }
  ]
});

const combinedSchema = JSON.stringify([
  JSON.parse(faqSchema),
  JSON.parse(breadcrumbSchema),
]);
---

<BaseLayout
  title="Custom Limestone Carving Ontario | Architectural Stone | Tulip"
  description="Custom Indiana Limestone carving for residential and commercial projects across Ontario. Architectural ornaments, sculptural commissions, and heritage replica work. Based in Brampton. Request a quote."
  pageClass="page-limestone-carving"
  solidNav={true}
  additionalSchema={combinedSchema}
>

  <Hero
    size="xs"
    imageSrc="/pictures/Limestone%20page%20images/carving.jpeg"
    imageAlt="Artisan Indiana Limestone carving — intricate architectural ornament custom fabricated by Tulip Limestone Precast, Brampton Ontario"
    eyebrow="INDIANA LIMESTONE · CUSTOM CARVING · ONTARIO MADE"
    headline="Limestone Carving."
    headlineItalic="Detail That Endures."
    primaryCTA="REQUEST A COMMISSION"
    primaryCTAHref="/contact?product=carving"
    secondaryCTA="VIEW ALL LIMESTONE"
    secondaryCTAHref="/limestone"
  />

  <section class="plp-intro" aria-label="Carving overview">
    <div class="plp-intro-container">
      <div class="plp-intro-content">
        <span class="label-section">Indiana Limestone · Artisan Carving</span>
        <h2 class="plp-intro-headline">Custom limestone carvings for Ontario's finest projects.</h2>
        <span class="plp-intro-rule draw-line" aria-hidden="true"></span>
        <p class="plp-intro-body">Indiana Limestone is a remarkable stone — its ease of workability and capacity to retain fine detail make it the preferred material for architectural carvers. At Tulip Precast in Brampton, Ontario, our carvers produce custom limestone ornaments, sculptural commissions, and heritage replica work for residential and commercial projects across the Greater Toronto Area and beyond.</p>
        <p class="plp-intro-body">Today's carvers are a diverse group of artisans — many continuing family traditions, working alongside those who shaped the craft before them. Whether you need a single carved keystone, a complete ornamental programme for a heritage restoration, or a custom sculptural commission from your own drawings, we produce every piece with the same precision and care that has characterised Indiana Limestone carving for over 150 years.</p>
      </div>
      <div class="plp-intro-facts">
        <div class="plp-fact">
          <span class="plp-fact-val">150+</span>
          <span class="plp-fact-lbl">Years of Indiana Limestone tradition</span>
        </div>
        <div class="plp-fact">
          <span class="plp-fact-val">Custom</span>
          <span class="plp-fact-lbl">Drawings required for every commission</span>
        </div>
        <div class="plp-fact">
          <span class="plp-fact-val">Heritage</span>
          <span class="plp-fact-lbl">Replica and restoration matching</span>
        </div>
      </div>
    </div>
  </section>

  <ProductSection
    id="carving"
    num="01"
    label="Limestone · Artisan Craft"
    title="Carving"
    imageSrc="/pictures/Limestone%20page%20images/carving.jpeg"
    imageAlt="Artisan Indiana limestone carved fireplace surround, custom fabricated by Tulip Limestone · Precast"
    imagePosition="center center"
    description="Indiana limestone is a remarkable stone — ranging from warm buff to cool blue-gray, prized across generations for its workability and its unique capacity to accept and retain crisp, intricate detail. Today's carvers are a diverse group of artisans, many continuing family traditions alongside those who shaped the craft before them. Their skill brings each design to life with timeless precision."
    callout={{ label: 'Custom Commission', body: 'When ordering a specialty carving, please provide: drawings and specifications, any full-size layouts available, and — for replica work — photographs and measurements of the existing piece. Our team will review and confirm feasibility before quoting.' }}
    flip={false}
  />

  <section class="plp-faq" aria-label="Frequently asked questions">
    <div class="plp-faq-container">
      <span class="label-section">Common Questions</span>
      <h2 class="plp-faq-title">Frequently Asked Questions</h2>
      <div class="plp-faq-list">
        <details class="plp-faq-item">
          <summary class="plp-faq-question">What can be carved in Indiana Limestone?</summary>
          <div class="plp-faq-answer"><p>Indiana Limestone can be carved into virtually any architectural ornament or sculptural form — including column capitals, keystones, door surround ornaments, heraldic shields, lettering, decorative friezes, garden sculptures, and full figurative commissions. Tulip Precast produces custom limestone carvings from client drawings for residential and commercial projects across Ontario.</p></div>
        </details>
        <details class="plp-faq-item">
          <summary class="plp-faq-question">Can you replicate existing limestone carvings?</summary>
          <div class="plp-faq-answer"><p>Yes. Tulip Precast specialises in heritage replica carving — producing exact matches for damaged or deteriorated limestone ornaments. Please provide drawings and specifications, full-size layouts if available, and photographs and measurements of the existing piece.</p></div>
        </details>
        <details class="plp-faq-item">
          <summary class="plp-faq-question">What do I need to provide when ordering a custom carving?</summary>
          <div class="plp-faq-answer"><p>When ordering a custom limestone carving, please provide: drawings and specifications, full-size layouts if available, and — for replica work — photographs and measurements of the existing piece. Contact us at office@tulipprecast.com or 647-534-7755 to begin the consultation.</p></div>
        </details>
        <details class="plp-faq-item">
          <summary class="plp-faq-question">Why is Indiana Limestone preferred for carving?</summary>
          <div class="plp-faq-answer"><p>Indiana Limestone is a favourite among architectural carvers because of its workability — it cuts cleanly, holds fine detail well, and does not splinter under carving tools. It retains carved detail over centuries, which is why it was chosen for the Empire State Building and the National Cathedral.</p></div>
        </details>
      </div>
    </div>
  </section>

  <section class="plp-related" aria-label="Related limestone products">
    <div class="plp-related-container">
      <span class="label-section">Also From Tulip Limestone</span>
      <div class="plp-related-grid">
        <a href="/limestone/columns" class="plp-related-tile">
          <span class="plp-related-name">Limestone Columns</span>
          <span class="plp-related-arrow">→</span>
        </a>
        <a href="/limestone#fireplaces" class="plp-related-tile">
          <span class="plp-related-name">Fireplaces &amp; Sculpturing</span>
          <span class="plp-related-arrow">→</span>
        </a>
        <a href="/limestone" class="plp-related-tile plp-related-tile--all">
          <span class="plp-related-name">All Limestone Products</span>
          <span class="plp-related-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <CTASection
    headline="Ready to specify Carving?"
    subheading="Send us your drawings and specifications. Our team will respond within one business day."
    buttonText="REQUEST A FREE QUOTE"
    buttonHref="/contact?product=carving"
    background="sage"
  />

</BaseLayout>

<style>

  /* ── Intro ───────────────────────────────────────────────── */

  .plp-intro {
    background: var(--sand-pale);
    padding: var(--space-3xl) 0;
    border-bottom: 1px solid var(--sand-light);
  }

  .plp-intro-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .plp-intro-headline {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-tight);
    margin: var(--space-xs) 0 var(--space-sm);
  }

  .plp-intro-rule {
    display: block;
    height: 1px;
    background: var(--sand-light);
    width: 60px;
    margin-bottom: var(--space-lg);
    transform-origin: left center;
  }

  .plp-intro-body {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: 62ch;
    margin-bottom: var(--space-md);
  }

  /* ── Fact pills ───────────────────────────────────────────── */

  .plp-intro-facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-top: var(--space-md);
  }

  .plp-fact {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    border-left: 3px solid var(--warm-sand);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .plp-fact-val {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 300;
    color: var(--stone-dark);
    line-height: 1;
  }

  .plp-fact-lbl {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--stone-light);
  }

  /* ── FAQ ──────────────────────────────────────────────────── */

  .plp-faq {
    background: var(--limestone-cream);
    padding: var(--space-3xl) 0;
    border-top: 1px solid var(--cream-dark);
  }

  .plp-faq-container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }

  .plp-faq-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    margin: var(--space-xs) 0 var(--space-xl);
    line-height: var(--lh-heading);
  }

  .plp-faq-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--cream-dark);
  }

  .plp-faq-item {
    border-bottom: 1px solid var(--cream-dark);
  }

  .plp-faq-item[open] {
    background: var(--white-warm);
  }

  .plp-faq-question {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
    padding: var(--space-lg) 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    transition: color 200ms ease;
  }

  .plp-faq-question::-webkit-details-marker { display: none; }

  .plp-faq-question::after {
    content: '+';
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 300;
    color: var(--warm-sand);
    flex-shrink: 0;
    transition: transform 300ms ease;
    line-height: 1;
  }

  .plp-faq-item[open] .plp-faq-question::after {
    transform: rotate(45deg);
  }

  .plp-faq-question:hover { color: var(--warm-sand); }

  .plp-faq-answer {
    padding: 0 0 var(--space-lg);
  }

  .plp-faq-answer p {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: none;
    margin: 0;
  }

  /* ── Related products ─────────────────────────────────────── */

  .plp-related {
    background: var(--sand-pale);
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--sand-light);
    border-bottom: 1px solid var(--sand-light);
  }

  .plp-related-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }

  .plp-related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .plp-related-tile {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    padding: var(--space-lg) var(--space-xl);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    text-decoration: none;
    transition:
      border-color 200ms ease,
      transform 200ms ease;
  }

  .plp-related-tile:hover {
    border-color: var(--warm-sand);
    transform: translateY(-2px);
  }

  .plp-related-tile--all {
    background: var(--stone-dark);
    border-color: var(--stone-dark);
  }

  .plp-related-tile--all .plp-related-name {
    color: var(--white-warm);
  }

  .plp-related-tile--all .plp-related-arrow {
    color: var(--warm-sand);
  }

  .plp-related-name {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
    line-height: var(--lh-heading);
  }

  .plp-related-arrow {
    font-size: var(--text-body);
    color: var(--warm-sand);
    flex-shrink: 0;
    transition: transform 200ms ease;
  }

  .plp-related-tile:hover .plp-related-arrow {
    transform: translateX(4px);
  }

  /* ── Responsive ───────────────────────────────────────────── */

  @media (max-width: 1024px) {
    .plp-intro-container {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .plp-intro-facts {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .plp-fact { flex: 1; min-width: 160px; }
  }

  @media (max-width: 640px) {
    .plp-related-grid { grid-template-columns: 1fr; }
    .plp-intro-facts  { flex-direction: column; }
  }

</style>
