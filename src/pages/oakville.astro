---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTASection from '../components/CTASection.astro';

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you serve Oakville for limestone fabrication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Oakville is one of our primary residential markets. We fabricate at our Brampton shop and deliver throughout Oakville including Old Oakville, Morrison, Eastlake, and Bronte. Our team handles unloading on residential deliveries."
      }
    },
    {
      "@type": "Question",
      "name": "Can you supply a complete limestone entrance for an Oakville home?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Complete entrance systems — columns, door surround, keystone, steps, and balustrade — are among our most common Oakville projects. All components are fabricated as a matched set from a single shop drawing package to ensure visual consistency."
      }
    },
    {
      "@type": "Question",
      "name": "What limestone colours work best for Oakville homes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends on your existing masonry and architectural style. Northern Buff suits traditional and Georgian architecture; Silver Shadow and Northern Gray work well with contemporary builds. We recommend requesting physical samples before specifying — natural stone colour varies and photographs are not reliable."
      }
    },
    {
      "@type": "Question",
      "name": "Do you work with Oakville builders and architects?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We work directly with custom home builders, architects, and landscape designers throughout Oakville. Full shop drawing packages, specification support, and coordinated delivery scheduling are standard on every project."
      }
    }
  ]
});

const localBizSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Tulip Limestone · Precast",
  "description": "Indiana Limestone columns, balustrades, and custom stonework for Oakville luxury residential projects.",
  "url": "https://www.tulipstone.ca/oakville",
  "telephone": "+1-647-534-7755",
  "email": "office@tulipprecast.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "98 Rutherford Rd Unit 2C",
    "addressLocality": "Brampton",
    "addressRegion": "ON",
    "postalCode": "L6W 3J5",
    "addressCountry": "CA"
  },
  "areaServed": {
    "@type": "City",
    "name": "Oakville"
  },
  "priceRange": "$$$"
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.tulipstone.ca" },
    { "@type": "ListItem", "position": 2, "name": "Oakville", "item": "https://www.tulipstone.ca/oakville" }
  ]
});

const combinedSchema = JSON.stringify([
  JSON.parse(faqSchema),
  JSON.parse(localBizSchema),
  JSON.parse(breadcrumbSchema),
]);
---

<BaseLayout
  title="Limestone Fabrication Oakville, ON | Luxury Stone | Tulip"
  description="Indiana Limestone columns, balustrades, and custom stonework for Oakville luxury residential projects. Custom shop drawings and heritage matching. Delivered from Brampton. Ontario Made."
  pageClass="page-geo-oakville"
  solidNav={true}
  additionalSchema={combinedSchema}
>

  <Hero
    size="xs"
    imageSrc="/pictures/column.jpg"
    imageAlt="Indiana Limestone Corinthian columns on Oakville luxury residential estate — Tulip Limestone Precast"
    eyebrow="OAKVILLE, ONTARIO · LUXURY RESIDENTIAL"
    headline="Limestone for"
    headlineItalic="Oakville Estates."
    primaryCTA="REQUEST A QUOTE"
    primaryCTAHref="/contact?location=oakville"
    secondaryCTA="VIEW PORTFOLIO"
    secondaryCTAHref="/portfolio"
  />

  <section class="geo-intro" aria-label="Oakville limestone services">
    <div class="geo-intro-container">
      <div class="geo-intro-text">
        <span class="label-section">Oakville, Ontario · Estate Residential</span>
        <h2 class="geo-intro-headline">Where architectural stone belongs.</h2>
        <span class="geo-intro-rule draw-line" aria-hidden="true"></span>
        <p class="geo-intro-body">Oakville homes — particularly through Old Oakville, Morrison, and the lakeshore — are built to a standard where materials matter. Indiana Limestone columns, balustrades, door surrounds, and carved detail are the elements that separate a well-built house from an estate. Tulip fabricates all of it to specification and delivers throughout Oakville.</p>
        <p class="geo-intro-body">Our most complete residential projects are Oakville properties: full limestone entrance systems with Corinthian columns, balustrade terraces, carved door surrounds, and matching pool coping. Every piece is fabricated from custom shop drawings so it fits the architecture rather than approximating it.</p>
      </div>
      <div class="geo-intro-facts">
        <div class="geo-fact">
          <span class="geo-fact-val">Estate</span>
          <span class="geo-fact-lbl">Residential specialists</span>
        </div>
        <div class="geo-fact">
          <span class="geo-fact-val">5</span>
          <span class="geo-fact-lbl">Classical column styles</span>
        </div>
        <div class="geo-fact">
          <span class="geo-fact-val">Custom</span>
          <span class="geo-fact-lbl">Shop drawings on every project</span>
        </div>
      </div>
    </div>
  </section>

  <section class="geo-products" aria-label="Products available">
    <div class="geo-products-container">
      <span class="label-section">Available in Oakville</span>
      <h2 class="geo-products-title">Estate-scale stonework.</h2>
      <p class="geo-products-intro">Full entrance systems, complete balustrade runs, matched pool surrounds.</p>
      <div class="geo-products-grid">
        <a href="/limestone/columns" class="geo-product-tile">
          <span class="geo-product-name">Columns</span>
          <span class="geo-product-desc">Five classical orders, handcrafted to specification.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/balusters" class="geo-product-tile">
          <span class="geo-product-name">Balusters</span>
          <span class="geo-product-desc">Solid limestone balustrades for terraces and staircases.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/pavers" class="geo-product-tile">
          <span class="geo-product-name">Pavers</span>
          <span class="geo-product-desc">Weather-resistant, natural traction in all conditions.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/carving" class="geo-product-tile">
          <span class="geo-product-name">Custom Carving</span>
          <span class="geo-product-desc">Hand-carved ornament and architectural detail.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone/sills" class="geo-product-tile">
          <span class="geo-product-name">Sills</span>
          <span class="geo-product-desc">Slip and lug sills in standard and custom profiles.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/limestone#pool-spa" class="geo-product-tile">
          <span class="geo-product-name">Pool &amp; Spa Stone</span>
          <span class="geo-product-desc">Matched coping and surrounds for estate pool areas.</span>
          <span class="geo-product-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="geo-why" aria-label="Why choose Tulip">
    <div class="geo-why-container">
      <span class="label-section">Why Oakville Estates Choose Tulip</span>
      <h2 class="geo-why-title">Consistency across every piece.</h2>
      <div class="geo-why-grid">
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">01</span>
          <h3 class="geo-why-heading">Estate-scale capability</h3>
          <p class="geo-why-body">Full entrance systems, complete balustrade runs, matched pool surrounds. We handle projects where every piece has to relate to every other piece.</p>
        </div>
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">02</span>
          <h3 class="geo-why-heading">Five classical column orders</h3>
          <p class="geo-why-body">Doric, Ionic, Corinthian, Tuscan, and Composite — each handcrafted with base, shaft, and capital produced to your architect's specification.</p>
        </div>
        <div class="geo-why-card">
          <span class="geo-why-num" aria-hidden="true">03</span>
          <h3 class="geo-why-heading">Visual consistency guaranteed</h3>
          <p class="geo-why-body">On large residential projects, colour and form consistency across hundreds of pieces is the hardest thing to achieve. It is what we are known for.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="geo-faq" aria-label="Frequently asked questions">
    <div class="geo-faq-container">
      <span class="label-section">Common Questions</span>
      <h2 class="geo-faq-title">Oakville — Frequently Asked</h2>
      <div class="geo-faq-list">
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Do you serve Oakville for limestone fabrication?</summary>
          <div class="geo-faq-a"><p>Yes. Oakville is one of our primary residential markets. We fabricate at our Brampton shop and deliver throughout Oakville including Old Oakville, Morrison, Eastlake, and Bronte. Our team handles unloading on residential deliveries.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Can you supply a complete limestone entrance for an Oakville home?</summary>
          <div class="geo-faq-a"><p>Yes. Complete entrance systems — columns, door surround, keystone, steps, and balustrade — are among our most common Oakville projects. All components are fabricated as a matched set from a single shop drawing package to ensure visual consistency.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">What limestone colours work best for Oakville homes?</summary>
          <div class="geo-faq-a"><p>It depends on your existing masonry and architectural style. Northern Buff suits traditional and Georgian architecture; Silver Shadow and Northern Gray work well with contemporary builds. We recommend requesting physical samples before specifying — natural stone colour varies and photographs are not reliable.</p></div>
        </details>
        <details class="geo-faq-item">
          <summary class="geo-faq-q">Do you work with Oakville builders and architects?</summary>
          <div class="geo-faq-a"><p>Yes. We work directly with custom home builders, architects, and landscape designers throughout Oakville. Full shop drawing packages, specification support, and coordinated delivery scheduling are standard on every project.</p></div>
        </details>
      </div>
    </div>
  </section>

  <CTASection
    headline="Building in Oakville?"
    subheading="Send your drawings or elevations. We will produce a detailed quote and shop drawing proposal."
    buttonText="REQUEST A QUOTE"
    buttonHref="/contact?location=oakville"
    background="sage"
  />

  <div class="geo-other-areas">
    <span class="geo-other-label">Also serving</span>
    <a href="/brampton">Brampton</a> ·
    <a href="/toronto">Toronto</a> ·
    <a href="/mississauga">Mississauga</a> ·
    <a href="/montreal">Montreal</a> ·
    <a href="/vancouver">Vancouver</a>
  </div>

</BaseLayout>

<style>
  .geo-intro {
    background: var(--sand-pale);
    padding: var(--space-3xl) 0;
    border-bottom: 1px solid var(--sand-light);
  }
  .geo-intro-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }
  .geo-intro-headline {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-tight);
    margin: var(--space-xs) 0 var(--space-sm);
  }
  .geo-intro-rule {
    display: block; height: 1px; width: 60px;
    background: var(--sand-light);
    margin-bottom: var(--space-lg);
    transform-origin: left center;
  }
  .geo-intro-body {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: 62ch;
    margin-bottom: var(--space-md);
  }
  .geo-intro-facts {
    display: flex; flex-direction: column;
    gap: var(--space-sm); padding-top: var(--space-md);
  }
  .geo-fact {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    border-left: 3px solid var(--warm-sand);
    padding: var(--space-lg);
    display: flex; flex-direction: column; gap: 4px;
  }
  .geo-fact-val {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 300;
    color: var(--stone-dark); line-height: 1;
  }
  .geo-fact-lbl {
    font-family: var(--font-sans); font-size: 9px;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase; color: var(--stone-light);
  }

  .geo-products {
    padding: var(--space-3xl) 0;
    background: var(--limestone-cream);
  }
  .geo-products-container {
    max-width: var(--max-width);
    margin: 0 auto; padding: 0 var(--content-padding);
  }
  .geo-products-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    margin: var(--space-xs) 0 var(--space-sm);
  }
  .geo-products-intro {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: 60ch;
    margin-bottom: var(--space-xl);
  }
  .geo-products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }
  .geo-product-tile {
    background: var(--white-warm);
    border: 1px solid var(--cream-dark);
    padding: var(--space-lg);
    display: flex; flex-direction: column;
    gap: var(--space-xs);
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .geo-product-tile:hover {
    border-color: var(--warm-sand);
    transform: translateY(-2px);
  }
  .geo-product-name {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
  }
  .geo-product-desc {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    flex: 1;
  }
  .geo-product-arrow {
    font-size: var(--text-body);
    color: var(--sand-light);
    margin-top: var(--space-xs);
    transition: color 200ms ease, transform 200ms ease;
  }
  .geo-product-tile:hover .geo-product-arrow {
    color: var(--warm-sand);
    transform: translateX(4px);
  }

  .geo-why {
    background: var(--quarry-stone);
    padding: var(--space-3xl) 0;
  }
  .geo-why-container {
    max-width: var(--max-width);
    margin: 0 auto; padding: 0 var(--content-padding);
  }
  .geo-why .label-section { color: rgba(200,168,130,0.7); }
  .geo-why-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--white-warm);
    margin: var(--space-xs) 0 var(--space-xl);
  }
  .geo-why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .geo-why-card {
    border: 1px solid rgba(200,168,130,0.14);
    background: rgba(255,255,255,0.03);
    padding: var(--space-xl);
  }
  .geo-why-num {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    font-weight: 300;
    color: rgba(200,168,130,0.2);
    display: block; line-height: 1;
    margin-bottom: var(--space-sm);
  }
  .geo-why-heading {
    font-family: var(--font-serif);
    font-size: var(--text-title);
    font-weight: 400;
    color: var(--white-warm);
    margin-bottom: var(--space-sm);
  }
  .geo-why-body {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-light);
    line-height: var(--lh-body);
  }

  .geo-faq {
    background: var(--sand-pale);
    padding: var(--space-3xl) 0;
  }
  .geo-faq-container {
    max-width: 760px; margin: 0 auto;
    padding: 0 var(--content-padding);
  }
  .geo-faq-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    color: var(--stone-dark);
    margin: var(--space-xs) 0 var(--space-xl);
  }
  .geo-faq-list {
    display: flex; flex-direction: column;
    border-top: 1px solid var(--cream-dark);
  }
  .geo-faq-item { border-bottom: 1px solid var(--cream-dark); }
  .geo-faq-q {
    font-family: var(--font-serif);
    font-size: var(--text-subtitle);
    font-weight: 400;
    color: var(--stone-dark);
    padding: var(--space-lg) 0;
    cursor: pointer; list-style: none;
    display: flex; align-items: center;
    justify-content: space-between; gap: var(--space-lg);
    transition: color 200ms ease;
  }
  .geo-faq-q::-webkit-details-marker { display: none; }
  .geo-faq-q::after {
    content: '+'; font-family: var(--font-sans);
    font-size: 18px; font-weight: 300;
    color: var(--warm-sand); flex-shrink: 0;
    transition: transform 300ms ease; line-height: 1;
  }
  .geo-faq-item[open] .geo-faq-q::after { transform: rotate(45deg); }
  .geo-faq-q:hover { color: var(--warm-sand); }
  .geo-faq-a {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 300ms ease;
  }
  .geo-faq-item[open] .geo-faq-a {
    grid-template-rows: 1fr;
  }
  .geo-faq-a p {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--stone-mid);
    line-height: var(--lh-body);
    max-width: none;
    margin: 0;
    padding-bottom: var(--space-lg);
    overflow: hidden;
    min-height: 0;
  }

  .geo-other-areas {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-lg) var(--content-padding);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--stone-light);
    text-align: center;
    border-top: 1px solid var(--cream-dark);
  }
  .geo-other-label {
    font-size: 9px;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    display: block;
    margin-bottom: var(--space-xs);
  }
  .geo-other-areas a {
    color: var(--stone-mid);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .geo-other-areas a:hover { color: var(--warm-sand); }

  @media (max-width: 1024px) {
    .geo-intro-container { grid-template-columns: 1fr; gap: var(--space-xl); }
    .geo-intro-facts { flex-direction: row; flex-wrap: wrap; }
    .geo-fact { flex: 1; min-width: 150px; }
    .geo-products-grid { grid-template-columns: repeat(2, 1fr); }
    .geo-why-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .geo-products-grid { grid-template-columns: 1fr; }
    .geo-intro-facts { flex-direction: column; }
  }
</style>
